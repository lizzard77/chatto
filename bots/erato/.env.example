# API-Key des Bots (Server Admin → Bots → Create Bot)
CHATTO_API_KEY=cht_BK_...
# Läuft lokal, also die öffentliche URL
CHATTO_URL=https://chat.he1.lizzard77.dev
# Vorschlag bei der Channel-Auswahl beim Start (Enter); ohne Terminal wird er direkt genommen
CHATTO_ROOM_ID=R6k04185Mlk60yv
# Optional: Opus-Bitrate in bit/s
#ERATO_BITRATE=128000
# Optional: 1 = lokal mithören (Loopback auf die normale Ausgabe); im Call zuhören ist besser
#ERATO_MONITOR=1
# Optional: weitere Quellen direkt in den Stream mischen (kommagetrennt), z. B. RØDECaster-Soundpads
#ERATO_SOURCES=alsa_input.usb-R__DE_RODECaster_Duo_IR0058207-00.pro-input-1
# Optional: Fensterfreigabe – Bildgröße, Bildrate, Bitrate in bit/s
#ERATO_VIDEO_SIZE=1920x1080
#ERATO_VIDEO_FPS=15
#ERATO_VIDEO_BITRATE=4000000
# vp8 (Standard), vp9, av1 oder h264
#ERATO_VIDEO_CODEC=vp8
# camera = als Kamerabild statt als Bildschirmfreigabe senden (wird in Chatto zugeschnitten)
#ERATO_VIDEO_AS=camera
# Optional: Chatto-Logins, die Erato per DM steuern dürfen (share, stop, status, quit)
#ERATO_DM_USERS=phil
