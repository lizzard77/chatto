# API-Key des Bots (Server Admin → Bots → Create Bot)
CHATTO_API_KEY=cht_BK_...
# Läuft lokal, also die öffentliche URL
CHATTO_URL=https://chat.he1.lizzard77.dev
# Raum, dessen Call Erato beitritt (Gameplay)
CHATTO_ROOM_ID=R6k04185Mlk60yv
# Optional: Opus-Bitrate in bit/s
#ERATO_BITRATE=128000
# Optional: 1 = lokal mithören (Loopback auf die normale Ausgabe); im Call zuhören ist besser
#ERATO_MONITOR=1
# Optional: weitere Quellen direkt in den Stream mischen (kommagetrennt), z. B. RØDECaster-Soundpads
#ERATO_SOURCES=alsa_input.usb-R__DE_RODECaster_Duo_IR0058207-00.pro-input-1
