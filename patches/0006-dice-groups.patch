+describe('buildVirtualItems dice grouping', () => {
+  const roll = (id: string, overrides: Partial<{ actorId: string; createdAt: string }> = {}) => {
+    const actorId = overrides.actorId ?? 'u_pantheon';
+    const event = makeMessageEvent({
+      id,
+      actorId,
+      createdAt: overrides.createdAt ?? '2025-04-27T12:00:00Z',
+      body: `**Phil** 🎲 **9** — 2d6: [4, 5] = 9 [🎲](#chatto-dice:std.6.4,std.6.5;by=u_phil)`
+    });
+    return {
+      ...event,
+      actor: { ...event.actor, id: actorId, login: 'pantheon', isBot: true }
+    } as TimelineEventView;
+  };
+  const shape = (items: VirtualItem[]) =>
+    items.map((item) =>
+      item.type === 'dice-group'
+        ? `dice:${item.events.map((event) => event.id).join(',')}`
+        : item.type === 'event'
+          ? item.event.id
+          : item.type
+    );
+
+  it('coalesces consecutive rolls of one bot and keys the group by the newest roll', () => {
+    const items = buildVirtualItems(
+      meta([makeMessageEvent({ id: 'hi' }), roll('r1'), roll('r2'), roll('r3')]),
+      null,
+      false
+    );
+    expect(shape(items)).toEqual(['day-separator', 'hi', 'dice:r1,r2,r3']);
+    const group = items[2];
+    expect(group.type === 'dice-group' && group.key).toBe('dice-group-r3');
+    expect(group.type === 'dice-group' && group.isFirstInGroup).toBe(true);
+  });
+
+  it('keeps a single roll as an ordinary row', () => {
+    const items = buildVirtualItems(
+      meta([roll('r1'), makeMessageEvent({ id: 'hi' })]),
+      null,
+      false
+    );
+    expect(shape(items)).toEqual(['day-separator', 'r1', 'hi']);
+  });
+
+  it('breaks a run at a human message, another bot, and the unread separator', () => {
+    const items = buildVirtualItems(
+      meta([
+        roll('a1'),
+        roll('a2'),
+        makeMessageEvent({ id: 'hi' }),
+        roll('b1'),
+        roll('b2', { actorId: 'u_other_bot' }),
+        roll('c1'),
+        roll('c2'),
+        roll('c3')
+      ]),
+      'c3',
+      false
+    );
+    expect(shape(items)).toEqual([
+      'day-separator',
+      'dice:a1,a2',
+      'hi',
+      'b1',
+      'b2',
+      'dice:c1,c2',
+      'unread-separator',
+      'c3'
+    ]);
+  });
+
+  it('ignores dice markers from people and breaks at a day separator', () => {
+    const human = makeMessageEvent({
+      id: 'h1',
+      createdAt: '2025-04-26T22:00:00Z',
+      body: 'look [🎲](#chatto-dice:std.6.4)'
+    });
+    const items = buildVirtualItems(
+      meta([
+        human,
+        roll('d1', { createdAt: '2025-04-26T23:00:00Z' }),
+        roll('d2', { createdAt: '2025-04-27T01:00:00Z' })
+      ]),
+      null,
+      false
+    );
+    expect(shape(items)).toEqual(['day-separator', 'h1', 'd1', 'day-separator', 'd2']);
+  });
+});
