+/**
+ * Dice bots, for example Pantheon, append a link `[🎲](#chatto-dice:…)` to
+ * each roll. Only the shape matters here, so this stays independent of the
+ * 3D dice renderer.
+ */
+const DICE_MARKER = '](#chatto-dice:';
+
+/** Fewer rolls than this stay ordinary rows. */
+export const MIN_DICE_GROUP_SIZE = 2;
+
+/**
+ * A dice roll that may join a run: a bot message with a dice marker that is
+ * not a channel echo and has no thread of its own. Returns the bot's user ID.
+ */
+export function diceRollActorId(view: TimelineEventView): string | null {
+  const payload = view.event;
+  if (!isMessagePostedEvent(payload) || payload.echoOfEventId != null) return null;
+  if (!view.actorId || view.actor?.isBot !== true) return null;
+  if (payload.threadRootEventId == null && (payload.threadExists || payload.replyCount > 0)) {
+    return null;
+  }
+  return payload.body?.includes(DICE_MARKER) ? view.actorId : null;
+}
