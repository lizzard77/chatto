+/**
+ * Turn dice bot markers (`[🎲](#chatto-dice:…)`, see `$lib/dice/diceSpec`)
+ * into replay buttons instead of links.
+ */
+function diceMarkers(state: StateCore): void {
+  for (const token of state.tokens) {
+    const children = token.type === 'inline' ? token.children : null;
+    if (!children) continue;
+    for (let i = 0; i + 2 < children.length; i++) {
+      const open = children[i];
+      if (open.type !== 'link_open' || children[i + 2].type !== 'link_close') continue;
+      const spec = diceSpecFromHref(open.attrGet('href') ?? '');
+      if (!spec) continue;
+      open.type = 'chatto_dice';
+      open.tag = '';
+      open.nesting = 0;
+      open.meta = { spec };
+      children.splice(i + 1, 2);
+    }
+  }
+}
+
+function renderDiceMarker(tokens: Token[], idx: number): string {
+  const spec = escapeAttribute(tokens[idx].meta.spec);
+  const label = escapeAttribute(m('dice.replay'));
+  return `<button type="button" class="chatto-dice-replay cursor-pointer rounded px-0.5 hover:opacity-70" data-chatto-dice="${spec}" title="${label}" aria-label="${label}">🎲</button>`;
+}
