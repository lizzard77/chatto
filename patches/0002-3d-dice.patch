+/**
+ * Dependency-free WebGL overlay that throws dice across the window.
+ *
+ * Results come from the dice bot, so nothing is simulated: every die follows a
+ * scripted path (thrown in from off-screen, bouncing, rolling to a stop) whose
+ * spin unwinds exactly into the pose that shows its value. The canvas exists
+ * only while a roll is on screen and never takes pointer events.
+ */
+
+import type { DieKind, DieSpec, SwadeOutcome } from './diceSpec';
+import {
+  add,
+  cross,
+  dieShape,
+  dot,
+  length,
+  normalize,
+  scale,
+  sub,
+  type DieShape,
+  type DieVariant,
+  type Vec3
+} from './diceGeometry';
+
+export type DiceLabels = {
+  hope: string;
+  fear: string;
+  adv: string;
+  dis: string;
+  withHope: string;
+  withFear: string;
+  critical: string;
+  wild: string;
+  swadeCritical: string;
+  swadeFailure: string;
+  swadeSuccess: string;
+  /** Success with raises; the caller words it for the roll's number of raises. */
+  swadeRaises: string;
+};
+
+type Theme = { body: string; edge: string; ink: string; label?: keyof DiceLabels; pill: string };
+
+/** Hope gold and Fear violet match the colours of Pantheon's text output. */
+const THEMES: Record<DieKind, Theme> = {
+  hope: { body: '#f2c230', edge: '#a87b00', ink: '#2a1a00', label: 'hope', pill: '#d9a514' },
+  fear: { body: '#4b2178', edge: '#24093f', ink: '#f1e6ff', label: 'fear', pill: '#8e44ad' },
+  adv: { body: '#27ae60', edge: '#15703b', ink: '#ffffff', label: 'adv', pill: '#27ae60' },
+  dis: { body: '#c0392b', edge: '#7a1d14', ink: '#ffffff', label: 'dis', pill: '#c0392b' },
+  gm: { body: '#6e1a1a', edge: '#330808', ink: '#ffd27a', pill: '#6e1a1a' },
+  std: { body: '#f3efe4', edge: '#a8a08a', ink: '#1f1f1f', pill: '#555555' },
+  drop: { body: '#8d8d8d', edge: '#555555', ink: '#e6e6e6', pill: '#555555' },
+  wild: { body: '#d35400', edge: '#7e3200', ink: '#ffffff', label: 'wild', pill: '#d35400' }
+};
+
+const ROLL_SECONDS = 1.6;
+const HOLD_SECONDS = 2.8;
+const FADE_SECONDS = 0.6;
+const PIXELS_PER_UNIT = 42;
+const FOV = (34 * Math.PI) / 180;
+const CAMERA_TILT = (22 * Math.PI) / 180;
+const CELL = 128;
+
+// ---------------------------------------------------------------------------
+// Matrix and quaternion helpers (column-major, like WebGL expects)
+// ---------------------------------------------------------------------------
+
+type Mat4 = Float32Array;
+type Quat = [number, number, number, number];
+
+function perspective(fovy: number, aspect: number, near: number, far: number): Mat4 {
+  const f = 1 / Math.tan(fovy / 2);
+  const out = new Float32Array(16);
+  out[0] = f / aspect;
+  out[5] = f;
+  out[10] = (far + near) / (near - far);
+  out[11] = -1;
+  out[14] = (2 * far * near) / (near - far);
+  return out;
+}
+
+function lookAt(eye: Vec3, target: Vec3, upHint: Vec3): Mat4 {
+  const z = normalize(sub(eye, target));
+  const x = normalize(cross(upHint, z));
+  const y = cross(z, x);
+  return new Float32Array([
+    x[0],
+    y[0],
+    z[0],
+    0,
+    x[1],
+    y[1],
+    z[1],
+    0,
+    x[2],
+    y[2],
+    z[2],
+    0,
+    -dot(x, eye),
+    -dot(y, eye),
+    -dot(z, eye),
+    1
+  ]);
+}
+
+function multiply(a: Mat4, b: Mat4): Mat4 {
+  const out = new Float32Array(16);
+  for (let col = 0; col < 4; col++) {
+    for (let row = 0; row < 4; row++) {
+      let sum = 0;
+      for (let k = 0; k < 4; k++) sum += a[k * 4 + row] * b[col * 4 + k];
+      out[col * 4 + row] = sum;
+    }
+  }
+  return out;
+}
+
+function axisAngle(axis: Vec3, angle: number): Quat {
+  const s = Math.sin(angle / 2);
+  return [axis[0] * s, axis[1] * s, axis[2] * s, Math.cos(angle / 2)];
+}
+
+function quatMultiply(a: Quat, b: Quat): Quat {
+  return [
+    a[3] * b[0] + a[0] * b[3] + a[1] * b[2] - a[2] * b[1],
+    a[3] * b[1] - a[0] * b[2] + a[1] * b[3] + a[2] * b[0],
+    a[3] * b[2] + a[0] * b[1] - a[1] * b[0] + a[2] * b[3],
+    a[3] * b[3] - a[0] * b[0] - a[1] * b[1] - a[2] * b[2]
+  ];
+}
+
+/** Quaternion of the rotation matrix with rows r0, r1, r2. */
+function quatFromRows(r0: Vec3, r1: Vec3, r2: Vec3): Quat {
+  const trace = r0[0] + r1[1] + r2[2];
+  if (trace > 0) {
+    const s = 0.5 / Math.sqrt(trace + 1);
+    return [(r2[1] - r1[2]) * s, (r0[2] - r2[0]) * s, (r1[0] - r0[1]) * s, 0.25 / s];
+  }
+  if (r0[0] > r1[1] && r0[0] > r2[2]) {
+    const s = 2 * Math.sqrt(1 + r0[0] - r1[1] - r2[2]);
+    return [0.25 * s, (r0[1] + r1[0]) / s, (r0[2] + r2[0]) / s, (r2[1] - r1[2]) / s];
+  }
+  if (r1[1] > r2[2]) {
+    const s = 2 * Math.sqrt(1 + r1[1] - r0[0] - r2[2]);
+    return [(r0[1] + r1[0]) / s, 0.25 * s, (r1[2] + r2[1]) / s, (r0[2] - r2[0]) / s];
+  }
+  const s = 2 * Math.sqrt(1 + r2[2] - r0[0] - r1[1]);
+  return [(r0[2] + r2[0]) / s, (r1[2] + r2[1]) / s, 0.25 * s, (r1[0] - r0[1]) / s];
+}
+
+/**
+ * Rotation that turns local `up` to world +Y and local `forward` to world -Z,
+ * which is "upright on screen" for the tilted top-down camera.
+ */
+function restingRotation(up: Vec3, forward: Vec3): Quat {
+  const side = cross(up, forward);
+  // R = W * L^T with L = [side | up | forward] and W = [-X | +Y | -Z].
+  const rows: Vec3[] = [scale(side, -1), up, scale(forward, -1)];
+  return quatFromRows(rows[0], rows[1], rows[2]);
+}
+
+function modelMatrix(q: Quat, t: Vec3): Mat4 {
+  const [x, y, z, w] = q;
+  return new Float32Array([
+    1 - 2 * (y * y + z * z),
+    2 * (x * y + z * w),
+    2 * (x * z - y * w),
+    0,
+    2 * (x * y - z * w),
+    1 - 2 * (x * x + z * z),
+    2 * (y * z + x * w),
+    0,
+    2 * (x * z + y * w),
+    2 * (y * z - x * w),
+    1 - 2 * (x * x + y * y),
+    0,
+    t[0],
+    t[1],
+    t[2],
+    1
+  ]);
+}
+
+const easeOutCubic = (t: number) => 1 - (1 - t) ** 3;
+const clamp01 = (t: number) => Math.min(1, Math.max(0, t));
+const random = (min: number, max: number) => min + Math.random() * (max - min);
+
+// ---------------------------------------------------------------------------
+// Textures and meshes
+// ---------------------------------------------------------------------------
+
+function atlasGrid(faceCount: number) {
+  const cols = faceCount <= 8 ? 4 : 8;
+  const rows = 2 ** Math.ceil(Math.log2(Math.ceil(faceCount / cols)));
+  return { cols, rows, width: cols * CELL, height: rows * CELL };
+}
+
+/** Face layout point → atlas pixel. Shared by painter and UVs so they agree. */
+function cellPoint(index: number, cols: number, [x, y]: [number, number]): [number, number] {
+  const cx = (index % cols) * CELL;
+  const cy = Math.floor(index / cols) * CELL;
+  return [cx + CELL * (0.5 + 0.46 * x), cy + CELL * (0.5 - 0.46 * y)];
+}
+
+function paintAtlas(shape: DieShape, theme: Theme): HTMLCanvasElement {
+  const { cols, width, height } = atlasGrid(shape.faces.length);
+  const canvas = document.createElement('canvas');
+  canvas.width = width;
+  canvas.height = height;
+  const ctx = canvas.getContext('2d')!;
+  ctx.fillStyle = theme.body;
+  ctx.fillRect(0, 0, width, height);
+
+  shape.faces.forEach((face, index) => {
+    const corners = face.layout.map((p) => cellPoint(index, cols, p));
+    const [ox, oy] = cellPoint(index, cols, [0, 0]);
+    const span = CELL * 0.46;
+
+    const glow = ctx.createRadialGradient(ox, oy, 0, ox, oy, span);
+    glow.addColorStop(0, 'rgba(255,255,255,0.16)');
+    glow.addColorStop(1, 'rgba(255,255,255,0)');
+    ctx.fillStyle = glow;
+    ctx.beginPath();
+    corners.forEach(([x, y], i) => (i ? ctx.lineTo(x, y) : ctx.moveTo(x, y)));
+    ctx.closePath();
+    ctx.fill();
+    ctx.lineWidth = CELL * 0.045;
+    ctx.lineJoin = 'round';
+    ctx.strokeStyle = theme.edge;
+    ctx.stroke();
+
+    ctx.fillStyle = theme.ink;
+    ctx.textAlign = 'center';
+    ctx.textBaseline = 'middle';
+    const draw = (text: string, x: number, y: number, angle: number, size: number) => {
+      ctx.save();
+      ctx.translate(x, y);
+      ctx.rotate(angle);
+      ctx.font = `700 ${size}px system-ui, "Segoe UI", Roboto, sans-serif`;
+      const width = ctx.measureText(text).width;
+      const fit = Math.min(1, (size * 1.25) / width);
+      if (fit < 1) ctx.font = `700 ${size * fit}px system-ui, "Segoe UI", Roboto, sans-serif`;
+      ctx.fillText(text, 0, 0);
+      if ((text === '6' || text === '9') && shape.sides > 6) {
+        ctx.fillRect(-size * 0.22, size * 0.42, size * 0.44, size * 0.07);
+      }
+      ctx.restore();
+    };
+
+    if (face.labels.length === 1) {
+      draw(face.labels[0], ox, oy, 0, span * face.inradius * 1.25);
+    } else {
+      // d4: one number per corner, upright towards that corner.
+      face.layout.forEach((corner, i) => {
+        const [px, py] = cellPoint(index, cols, [corner[0] * 0.56, corner[1] * 0.56]);
+        draw(face.labels[i], px, py, Math.atan2(px - ox, -(py - oy)), span * 0.42);
+      });
+    }
+  });
+  return canvas;
+}
+
+function buildMesh(shape: DieShape): Float32Array {
+  const { cols, width, height } = atlasGrid(shape.faces.length);
+  const data: number[] = [];
+  shape.faces.forEach((face, index) => {
+    const uv = face.layout.map((p) => {
+      const [x, y] = cellPoint(index, cols, p);
+      return [x / width, y / height];
+    });
+    for (let i = 1; i < face.corners.length - 1; i++) {
+      for (const k of [0, i, i + 1]) {
+        data.push(...face.corners[k], ...face.normal, uv[k][0], uv[k][1]);
+      }
+    }
+  });
+  return new Float32Array(data);
+}
+
+// ---------------------------------------------------------------------------
+// GL programs
+// ---------------------------------------------------------------------------
+
+const DIE_VS = `
+attribute vec3 aPos; attribute vec3 aNormal; attribute vec2 aUv;
+uniform mat4 uModel; uniform mat4 uViewProj;
+varying vec3 vNormal; varying vec2 vUv; varying vec3 vWorld;
+void main() {
+  vec4 world = uModel * vec4(aPos, 1.0);
+  vWorld = world.xyz;
+  vNormal = (uModel * vec4(aNormal, 0.0)).xyz;
+  vUv = aUv;
+  gl_Position = uViewProj * world;
+}`;
+
+const DIE_FS = `
+precision mediump float;
+uniform sampler2D uTex; uniform vec3 uLight; uniform vec3 uEye; uniform float uAlpha;
+varying vec3 vNormal; varying vec2 vUv; varying vec3 vWorld;
+void main() {
+  vec3 n = normalize(vNormal);
+  vec3 l = normalize(uLight);
+  vec3 h = normalize(l + normalize(uEye - vWorld));
+  float diffuse = max(dot(n, l), 0.0);
+  float spec = pow(max(dot(n, h), 0.0), 48.0) * 0.3;
+  vec3 color = texture2D(uTex, vUv).rgb * (0.42 + 0.68 * diffuse) + spec;
+  gl_FragColor = vec4(color * uAlpha, uAlpha);
+}`;
+
+const SHADOW_VS = `
+attribute vec2 aCorner;
+uniform mat4 uViewProj; uniform vec3 uCenter; uniform float uRadius;
+varying vec2 vCorner;
+void main() {
+  vCorner = aCorner;
+  gl_Position = uViewProj * vec4(uCenter + vec3(aCorner.x, 0.0, aCorner.y) * uRadius, 1.0);
+}`;
+
+const SHADOW_FS = `
+precision mediump float;
+uniform float uAlpha;
+varying vec2 vCorner;
+void main() {
+  float a = smoothstep(1.0, 0.15, length(vCorner)) * uAlpha;
+  gl_FragColor = vec4(0.0, 0.0, 0.0, a);
+}`;
+
+function compile(gl: WebGLRenderingContext, vs: string, fs: string): WebGLProgram {
+  const program = gl.createProgram()!;
+  for (const [type, source] of [
+    [gl.VERTEX_SHADER, vs],
+    [gl.FRAGMENT_SHADER, fs]
+  ] as const) {
+    const shader = gl.createShader(type)!;
+    gl.shaderSource(shader, source);
+    gl.compileShader(shader);
+    if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
+      throw new Error(gl.getShaderInfoLog(shader) ?? 'shader compile failed');
+    }
+    gl.attachShader(program, shader);
+  }
+  gl.linkProgram(program);
+  if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
+    throw new Error(gl.getProgramInfoLog(program) ?? 'program link failed');
+  }
+  return program;
+}
+
+// ---------------------------------------------------------------------------
+// Scene
+// ---------------------------------------------------------------------------
+
+type Die = {
+  spec: DieSpec;
+  shape: DieShape;
+  shapeKey: string;
+  textureKey: string;
+  start: Vec3;
+  end: Vec3;
+  rest: number;
+  finalRotation: Quat;
+  spinAxis: Vec3;
+  spin: number;
+  delay: number;
+  duration: number;
+  bounce: number;
+  label?: HTMLElement;
+};
+
+type Camera = { viewProj: Mat4; eye: Vec3; halfWidth: number; halfDepth: number };
+
+function camera(width: number, height: number): Camera {
+  const visibleHeight = height / PIXELS_PER_UNIT;
+  const distance = visibleHeight / 2 / Math.tan(FOV / 2);
+  const eye: Vec3 = [0, distance * Math.cos(CAMERA_TILT), distance * Math.sin(CAMERA_TILT)];
+  const view = lookAt(eye, [0, 0, 0], [0, 0, -1]);
+  const projection = perspective(FOV, width / height, 0.5, distance * 3);
+  return {
+    viewProj: multiply(projection, view),
+    eye,
+    halfWidth: width / PIXELS_PER_UNIT / 2,
+    halfDepth: visibleHeight / 2
+  };
+}
+
+function project(cam: Camera, p: Vec3, width: number, height: number): [number, number] {
+  const m = cam.viewProj;
+  const x = m[0] * p[0] + m[4] * p[1] + m[8] * p[2] + m[12];
+  const y = m[1] * p[0] + m[5] * p[1] + m[9] * p[2] + m[13];
+  const w = m[3] * p[0] + m[7] * p[1] + m[11] * p[2] + m[15];
+  return [((x / w + 1) / 2) * width, ((1 - y / w) / 2) * height];
+}
+
+type ShownDie = { spec: DieSpec; sides: number; variant: DieVariant };
+
+/** d100 is two d10: tens and units. */
+function expandDice(dice: DieSpec[]): ShownDie[] {
+  return dice.flatMap((spec): ShownDie[] =>
+    spec.sides === 100
+      ? [
+          { spec, sides: 10, variant: 'tens' },
+          { spec, sides: 10, variant: 'units' }
+        ]
+      : [{ spec, sides: spec.sides, variant: 'normal' }]
+  );
+}
+
+function layoutDice(dice: ShownDie[], cam: Camera): Die[] {
+  const perRow = Math.max(2, Math.min(6, Math.floor((cam.halfWidth * 2 - 2) / 2.6)));
+  const rows = Math.ceil(dice.length / perRow);
+  const centre: Vec3 = [random(-0.2, 0.2) * cam.halfWidth, 0, random(-0.05, 0.2) * cam.halfDepth];
+  // One throw for all dice, from the lower left or lower right.
+  const fromLeft = Math.random() < 0.5;
+  const direction = normalize([fromLeft ? 1 : -1, 0, random(-0.9, -0.3)]);
+  const travel = Math.hypot(cam.halfWidth, cam.halfDepth) + 3;
+
+  return dice.map(({ spec, sides, variant }, index) => {
+    const row = Math.floor(index / perRow);
+    const inRow = Math.min(perRow, dice.length - row * perRow);
+    const column = index % perRow;
+    const end: Vec3 = [
+      centre[0] + (column - (inRow - 1) / 2) * 2.6 + random(-0.25, 0.25),
+      0,
+      centre[2] + (row - (rows - 1) / 2) * 2.6 + random(-0.25, 0.25)
+    ];
+    const shape = dieShape(sides, variant);
+    const pose = shape.restingPose(spec.value);
+    const yaw = axisAngle([0, 1, 0], random(-0.3, 0.3));
+    const finalRotation = quatMultiply(yaw, restingRotation(pose.up, pose.forward));
+    const rest = shape.restHeight(pose.up);
+    end[1] = rest;
+    const start = add(sub(end, scale(direction, travel)), [0, random(3, 5), 0]);
+    const rollAxis = normalize(cross([0, 1, 0], direction));
+    const wobble = normalize([random(-1, 1), random(-1, 1), random(-1, 1)]);
+    return {
+      spec,
+      shape,
+      shapeKey: `${sides}:${variant}`,
+      textureKey: `${sides}:${variant}:${spec.kind}`,
+      start,
+      end,
+      rest,
+      finalRotation,
+      spinAxis: normalize(add(rollAxis, scale(wobble, 0.35))),
+      spin: length(sub(end, start)) / 0.9 + random(0, Math.PI),
+      delay: index * 0.05 + random(0, 0.08),
+      duration: ROLL_SECONDS + random(-0.15, 0.25),
+      bounce: random(2.2, 3)
+    };
+  });
+}
+
+function dieState(die: Die, time: number): { position: Vec3; rotation: Quat; height: number } {
+  const s = clamp01((time - die.delay) / die.duration);
+  const position = add(die.start, scale(sub(die.end, die.start), easeOutCubic(s)));
+  // Falls onto the table at s = 0.2, then decaying hops that land at s = 0.6 and 1.
+  const lift =
+    s < 0.2
+      ? (die.start[1] - die.rest) * (1 - (s / 0.2) ** 2)
+      : die.bounce * (1 - s) ** 2 * Math.abs(Math.sin((Math.PI * (s - 0.2)) / 0.4));
+  position[1] = die.rest + lift;
+  const remaining = die.spin * (1 - easeOutCubic(clamp01(s / 0.94)));
+  const rotation = quatMultiply(axisAngle(die.spinAxis, -remaining), die.finalRotation);
+  return { position, rotation, height: lift };
+}
+
+export class DiceOverlay {
+  readonly #root: HTMLDivElement;
+  readonly #canvas: HTMLCanvasElement;
+  readonly #gl: WebGLRenderingContext;
+  readonly #dieProgram: WebGLProgram;
+  readonly #shadowProgram: WebGLProgram;
+  readonly #meshes = new Map<string, { buffer: WebGLBuffer; count: number }>();
+  readonly #textures = new Map<string, WebGLTexture>();
+  readonly #shadowBuffer: WebGLBuffer;
+  #dice: Die[] = [];
+  #banner: HTMLElement | null = null;
+  #startedAt = 0;
+  #frame = 0;
+  #onDone: () => void;
+
+  constructor(onDone: () => void) {
+    this.#onDone = onDone;
+    this.#root = document.createElement('div');
+    this.#root.setAttribute('aria-hidden', 'true');
+    this.#root.style.cssText =
+      'position:fixed;inset:0;pointer-events:none;z-index:2147483000;overflow:hidden;';
+    this.#canvas = document.createElement('canvas');
+    this.#canvas.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;';
+    this.#root.append(this.#canvas);
+    const gl = this.#canvas.getContext('webgl', { alpha: true, antialias: true });
+    if (!gl) throw new Error('WebGL unavailable');
+    this.#gl = gl;
+    this.#dieProgram = compile(gl, DIE_VS, DIE_FS);
+    this.#shadowProgram = compile(gl, SHADOW_VS, SHADOW_FS);
+    this.#shadowBuffer = gl.createBuffer()!;
+    gl.bindBuffer(gl.ARRAY_BUFFER, this.#shadowBuffer);
+    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
+    document.body.append(this.#root);
+  }
+
+  /** Throw a new set of dice; any dice still on screen are cleared. */
+  roll(dice: DieSpec[], labels: DiceLabels, swade: SwadeOutcome | null = null): void {
+    for (const die of this.#dice) die.label?.remove();
+    this.#banner?.remove();
+    this.#banner = null;
+
+    const { width, height } = this.#resize();
+    const cam = camera(width, height);
+    this.#dice = layoutDice(expandDice(dice), cam);
+    for (const die of this.#dice) {
+      this.#ensureResources(die);
+      const theme = THEMES[die.spec.kind];
+      if (theme.label) die.label = this.#pill(labels[theme.label], theme.pill, '13px');
+    }
+
+    const hope = dice.find((d) => d.kind === 'hope');
+    const fear = dice.find((d) => d.kind === 'fear');
+    if (hope && fear) {
+      const [text, color] =
+        hope.value === fear.value
+          ? [labels.critical, '#ff9500']
+          : hope.value > fear.value
+            ? [labels.withHope, THEMES.hope.pill]
+            : [labels.withFear, THEMES.fear.pill];
+      this.#banner = this.#pill(text, color, '20px');
+    } else if (swade !== null) {
+      const [text, color] =
+        swade === 'cf'
+          ? [labels.swadeCritical, '#8e44ad']
+          : swade === 'fail'
+            ? [labels.swadeFailure, '#555555']
+            : swade > 0
+              ? [labels.swadeRaises, '#ff9500']
+              : [labels.swadeSuccess, '#27ae60'];
+      this.#banner = this.#pill(text, color, '20px');
+    }
+
+    this.#startedAt = performance.now();
+    cancelAnimationFrame(this.#frame);
+    this.#frame = requestAnimationFrame(this.#render);
+  }
+
+  destroy(): void {
+    cancelAnimationFrame(this.#frame);
+    this.#gl.getExtension('WEBGL_lose_context')?.loseContext();
+    this.#root.remove();
+  }
+
+  #pill(text: string, color: string, size: string): HTMLElement {
+    const el = document.createElement('div');
+    el.textContent = text;
+    el.style.cssText =
+      `position:absolute;left:0;top:0;transform:translate(-50%,-50%);opacity:0;` +
+      `transition:opacity .25s;white-space:nowrap;font:700 ${size} system-ui,sans-serif;` +
+      `color:#fff;background:${color};padding:.15em .6em;border-radius:999px;` +
+      `box-shadow:0 2px 8px rgba(0,0,0,.35);text-shadow:0 1px 1px rgba(0,0,0,.35);`;
+    this.#root.append(el);
+    return el;
+  }
+
+  #resize() {
+    const ratio = Math.min(window.devicePixelRatio || 1, 1.5);
+    const width = window.innerWidth;
+    const height = window.innerHeight;
+    if (this.#canvas.width !== Math.round(width * ratio))
+      this.#canvas.width = Math.round(width * ratio);
+    if (this.#canvas.height !== Math.round(height * ratio))
+      this.#canvas.height = Math.round(height * ratio);
+    return { width, height };
+  }
+
+  #ensureResources(die: Die): void {
+    const gl = this.#gl;
+    if (!this.#meshes.has(die.shapeKey)) {
+      const data = buildMesh(die.shape);
+      const buffer = gl.createBuffer()!;
+      gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
+      gl.bufferData(gl.ARRAY_BUFFER, data, gl.STATIC_DRAW);
+      this.#meshes.set(die.shapeKey, { buffer, count: data.length / 8 });
+    }
+    if (!this.#textures.has(die.textureKey)) {
+      const texture = gl.createTexture()!;
+      gl.bindTexture(gl.TEXTURE_2D, texture);
+      gl.texImage2D(
+        gl.TEXTURE_2D,
+        0,
+        gl.RGBA,
+        gl.RGBA,
+        gl.UNSIGNED_BYTE,
+        paintAtlas(die.shape, THEMES[die.spec.kind])
+      );
+      gl.generateMipmap(gl.TEXTURE_2D);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR_MIPMAP_LINEAR);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
+      this.#textures.set(die.textureKey, texture);
+    }
+  }
+
+  #render = (now: number) => {
+    const time = (now - this.#startedAt) / 1000;
+    const landed = Math.max(...this.#dice.map((d) => d.delay + d.duration));
+    const fade = clamp01((time - landed - HOLD_SECONDS) / FADE_SECONDS);
+    if (fade >= 1) {
+      this.#onDone();
+      return;
+    }
+    const alpha = 1 - fade;
+
+    const { width, height } = this.#resize();
+    const cam = camera(width, height);
+    const gl = this.#gl;
+    gl.viewport(0, 0, this.#canvas.width, this.#canvas.height);
+    gl.clearColor(0, 0, 0, 0);
+    gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
+    gl.enable(gl.BLEND);
+    gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);
+
+    const states = this.#dice.map((die) => dieState(die, time));
+
+    // Soft contact shadows first, without depth.
+    gl.disable(gl.DEPTH_TEST);
+    gl.disable(gl.CULL_FACE);
+    gl.useProgram(this.#shadowProgram);
+    gl.bindBuffer(gl.ARRAY_BUFFER, this.#shadowBuffer);
+    const corner = gl.getAttribLocation(this.#shadowProgram, 'aCorner');
+    gl.enableVertexAttribArray(corner);
+    gl.vertexAttribPointer(corner, 2, gl.FLOAT, false, 0, 0);
+    gl.uniformMatrix4fv(
+      gl.getUniformLocation(this.#shadowProgram, 'uViewProj'),
+      false,
+      cam.viewProj
+    );
+    states.forEach(({ position, height: lift }) => {
+      const near = 1 - Math.min(1, lift / 5);
+      gl.uniform3f(
+        gl.getUniformLocation(this.#shadowProgram, 'uCenter'),
+        position[0],
+        0,
+        position[2]
+      );
+      gl.uniform1f(gl.getUniformLocation(this.#shadowProgram, 'uRadius'), 1.5 + lift * 0.25);
+      gl.uniform1f(gl.getUniformLocation(this.#shadowProgram, 'uAlpha'), 0.4 * near * alpha);
+      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
+    });
+    gl.disableVertexAttribArray(corner);
+
+    gl.enable(gl.DEPTH_TEST);
+    gl.enable(gl.CULL_FACE);
+    const program = this.#dieProgram;
+    gl.useProgram(program);
+    gl.uniformMatrix4fv(gl.getUniformLocation(program, 'uViewProj'), false, cam.viewProj);
+    gl.uniform3f(gl.getUniformLocation(program, 'uLight'), -0.4, 1, 0.55);
+    gl.uniform3f(gl.getUniformLocation(program, 'uEye'), ...cam.eye);
+    gl.uniform1f(gl.getUniformLocation(program, 'uAlpha'), alpha);
+    const pos = gl.getAttribLocation(program, 'aPos');
+    const normal = gl.getAttribLocation(program, 'aNormal');
+    const uv = gl.getAttribLocation(program, 'aUv');
+    this.#dice.forEach((die, index) => {
+      const { position, rotation } = states[index];
+      const mesh = this.#meshes.get(die.shapeKey)!;
+      gl.bindBuffer(gl.ARRAY_BUFFER, mesh.buffer);
+      gl.enableVertexAttribArray(pos);
+      gl.vertexAttribPointer(pos, 3, gl.FLOAT, false, 32, 0);
+      gl.enableVertexAttribArray(normal);
+      gl.vertexAttribPointer(normal, 3, gl.FLOAT, false, 32, 12);
+      gl.enableVertexAttribArray(uv);
+      gl.vertexAttribPointer(uv, 2, gl.FLOAT, false, 32, 24);
+      gl.bindTexture(gl.TEXTURE_2D, this.#textures.get(die.textureKey)!);
+      gl.uniformMatrix4fv(
+        gl.getUniformLocation(program, 'uModel'),
+        false,
+        modelMatrix(rotation, position)
+      );
+      gl.drawArrays(gl.TRIANGLES, 0, mesh.count);
+
+      if (die.label) {
+        const [x, y] = project(cam, [position[0], 0, position[2] + 1.45], width, height);
+        die.label.style.left = `${x}px`;
+        die.label.style.top = `${y}px`;
+        die.label.style.opacity = time >= die.delay + die.duration ? String(alpha) : '0';
+      }
+    });
+
+    if (this.#banner) {
+      const xs = this.#dice.map((d) => d.end[0]);
+      const zs = this.#dice.map((d) => d.end[2]);
+      const centreX = (Math.min(...xs) + Math.max(...xs)) / 2;
+      const [x, y] = project(cam, [centreX, 0, Math.min(...zs) - 1.9], width, height);
+      this.#banner.style.left = `${x}px`;
+      this.#banner.style.top = `${y}px`;
+      this.#banner.style.opacity = time >= landed ? String(alpha) : '0';
+    }
+
+    this.#frame = requestAnimationFrame(this.#render);
+  };
+}
