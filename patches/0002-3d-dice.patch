@@ -0,0 +1,114 @@
+/**
+ * Dice roll markers in message bodies.
+ *
+ * A dice bot (for example Pantheon) appends a link `[🎲](#chatto-dice:<payload>)`
+ * to its roll result. The text stays readable for clients without this patch,
+ * while the patched renderer turns the link into a replay button and rolls
+ * the dice in 3D when the message arrives live.
+ *
+ * `<payload>` is a comma-separated list of `<kind>.<sides>.<value>` entries, for
+ * example `hope.12.7,fear.12.3,adv.6.4`, optionally followed by parameters:
+ * `;by=<userId>` names who rolled (the bot posts the message, so its author is
+ * the bot), `;sw=<outcome>` is the Savage Worlds result of a trait roll
+ * (`cf` critical failure, `fail`, `ok`, `r<n>` success with n raises), and
+ * `;gm=1` marks a roll made in the bot's GM mode. Other `;<name>=<value>`
+ * parameters are ignored, so bots can add parameters without breaking rolls.
+ */
+
+export const DICE_MARKER_PREFIX = '#chatto-dice:';
+
+/** What a die means for the roll; it selects colours and labels. */
+export type DieKind = 'hope' | 'fear' | 'adv' | 'dis' | 'gm' | 'std' | 'drop' | 'wild';
+
+export const dieKinds: readonly DieKind[] = [
+  'hope',
+  'fear',
+  'adv',
+  'dis',
+  'gm',
+  'std',
+  'drop',
+  'wild'
+];
+
+/** Die shapes that the renderer can show. d100 is shown as two d10. */
+export const supportedSides = [4, 6, 8, 10, 12, 20, 100] as const;
+
+export type DieSpec = { kind: DieKind; sides: number; value: number };
+
+/** Savage Worlds trait roll result: critical failure, failure, or the number of raises. */
+export type SwadeOutcome = 'cf' | 'fail' | number;
+
+/** At most this many dice are rolled at once. */
+export const MAX_DICE = 24;
+
+const ENTRY = /^([a-z]+)\.(\d{1,3})\.(\d{1,3})$/;
+const PAYLOAD =
+  /^([a-z]+\.\d+\.\d+(?:,[a-z]+\.\d+\.\d+){0,63})((?:;by=[\w-]{1,64}|;sw=(?:cf|fail|ok|r\d)|;[a-z]{1,8}=[\w-]{1,32})*)$/;
+const MARKER_IN_BODY = /\]\(#chatto-dice:([^)\s]{1,700})\)/;
+
+/** Parse a dice list; returns null when it is malformed or contains no showable die. */
+export function parseDiceSpec(spec: string): DieSpec[] | null {
+  const dice: DieSpec[] = [];
+  for (const entry of spec.split(',')) {
+    const match = ENTRY.exec(entry);
+    if (!match) return null;
+    const kind = match[1] as DieKind;
+    const sides = Number(match[2]);
+    const value = Number(match[3]);
+    if (!dieKinds.includes(kind) || value < 1 || value > sides) return null;
+    if (!(supportedSides as readonly number[]).includes(sides)) continue;
+    if (dice.length < MAX_DICE) dice.push({ kind, sides, value });
+  }
+  return dice.length > 0 ? dice : null;
+}
+
+/**
+ * The payload of a marker link href, or null for any other href. Only checks
+ * the shape, so the markdown renderer stays small; rolls parse it fully.
+ */
+export function diceSpecFromHref(href: string): string | null {
+  if (!href.startsWith(DICE_MARKER_PREFIX)) return null;
+  const payload = href.slice(DICE_MARKER_PREFIX.length);
+  return PAYLOAD.test(payload) ? payload : null;
+}
+
+export type DiceRoll = {
+  dice: DieSpec[];
+  rollerId: string | null;
+  swade: SwadeOutcome | null;
+  /** The roll was made in the dice bot's GM mode. */
+  gm: boolean;
+};
+
+function swadeOutcome(value: string | undefined): SwadeOutcome | null {
+  if (value === 'cf' || value === 'fail') return value;
+  if (value === 'ok') return 0;
+  return value?.startsWith('r') ? Number(value.slice(1)) : null;
+}
+
+/** Parse a marker payload (dice list plus parameters). */
+export function parseDiceRoll(payload: string): DiceRoll | null {
+  const match = PAYLOAD.exec(payload);
+  const dice = match ? parseDiceSpec(match[1]) : null;
+  if (!match || !dice) return null;
+  const params = new Map(
+    match[2]
+      .split(';')
+      .filter(Boolean)
+      .map((param) => param.split('=') as [string, string])
+  );
+  return {
+    dice,
+    rollerId: params.get('by') ?? null,
+    swade: swadeOutcome(params.get('sw')),
+    gm: params.get('gm') === '1'
+  };
+}
+
+/** The roll of the first marker in a raw markdown body. */
+export function diceRollFromMessageBody(body: string | undefined): DiceRoll | null {
+  if (!body || !body.includes(DICE_MARKER_PREFIX)) return null;
+  const match = MARKER_IN_BODY.exec(body);
+  return match ? parseDiceRoll(match[1]) : null;
+}
