+/**
+ * Named colour schemes: a theme, an accent, and a tone for each theme, set
+ * together from App Preferences. Choosing a scheme only writes these existing
+ * preferences, so first paint needs no extra code.
+ */
+export const colorSchemes = {
+  nachtgold: {
+    displayTheme: 'dark',
+    accentColor: 'gold',
+    lightSurfaceTone: 'navy',
+    darkSurfaceTone: 'navy'
+  }
+} as const satisfies Record<
+  string,
+  Pick<AppPreferences, 'displayTheme' | 'accentColor' | 'lightSurfaceTone' | 'darkSurfaceTone'>
+>;
+
+export type ColorSchemeName = keyof typeof colorSchemes;
+
 export class UserPreferencesState {
   #preferences = $state<AppPreferences>(loadAppPreferences());
   readonly #prefersDark = new MediaQuery('(prefers-color-scheme: dark)', false);
@@ -539,6 +560,33 @@ export class UserPreferencesState {
     this.#applySurfaceTones();
   }
 
+  /**
+   * True while the preferences match the colour scheme. Depth and contrast
+   * stay free, so they do not count.
+   */
+  isColorScheme(name: ColorSchemeName): boolean {
+    const scheme = colorSchemes[name];
+    return (
+      this.#preferences.displayTheme === scheme.displayTheme &&
+      this.#preferences.accentColor === scheme.accentColor &&
+      this.#preferences.lightSurfaceTone === scheme.lightSurfaceTone &&
+      this.#preferences.darkSurfaceTone === scheme.darkSurfaceTone
+    );
+  }
+
+  /** Set theme, accent, and both tones of a colour scheme in one step. */
+  applyColorScheme(name: ColorSchemeName): void {
+    const scheme = colorSchemes[name];
+    this.#preferences.accentColor = scheme.accentColor;
+    this.#preferences.lightSurfaceTone = scheme.lightSurfaceTone;
+    this.#preferences.darkSurfaceTone = scheme.darkSurfaceTone;
+    this.#preferences.displayTheme = scheme.displayTheme;
+    this.#persist();
+    applyAccentColor(scheme.accentColor);
+    this.#applySurfaceTones();
+    applyDisplayTheme(scheme.displayTheme);
+  }
+
   /** Bevel strength shared by all servers in this browser. */
   get surfaceDepth(): number {
     return this.#preferences.surfaceDepth;
