@@ -0,0 +1,242 @@
+/**
+ * Annotations of one image in the attachment viewer: reads them from the
+ * thread of the image message, keeps them live, and posts or retracts the
+ * viewer's own. See `annotationSpec.ts` for the message format.
+ */
+
+// Maps, sets and dates here are short-lived locals of getters, never reactive state.
+/* eslint-disable svelte/prefer-svelte-reactivity */
+import { createMessageAPI } from '@chatto/client/api/messages';
+import type { MessagesStore } from '@chatto/client/room/messages/MessagesStore';
+import type { ServerStateStore } from '@chatto/client/server/store';
+import { isMessagePostedEvent } from '@chatto/client/timeline/timelineEvents';
+import { serverConnectionManager, serverRegistry } from '$lib/client';
+import {
+  annotationMarker,
+  assignColors,
+  parseAnnotation,
+  type Annotation,
+  type AnnotationShape
+} from './annotationSpec';
+
+/** Older thread pages loaded at most when the viewer opens. */
+const MAX_PAGES = 20;
+
+export type AnnotationTarget = {
+  serverId: string;
+  roomId: string;
+  /** The message that carries the image. */
+  eventId: string;
+  assetId: string;
+};
+
+type Pending = {
+  shape: AnnotationShape;
+  marker: string;
+  createdAt: string;
+  movedEventId: string | null;
+};
+
+/** One annotation message of this image as posted (an annotation or a move). */
+type Entry = {
+  eventId: string;
+  authorId: string;
+  createdAt: string;
+  shape: AnnotationShape;
+  movedEventId: string | null;
+  marker: string;
+};
+
+export class ImageAnnotations {
+  readonly #target: AnnotationTarget;
+  readonly #stores: ServerStateStore | undefined;
+  readonly #thread: MessagesStore | null = null;
+  readonly #threadRootEventId: string;
+  #disposed = false;
+  // Raw: entries are compared by identity, which a deep $state proxy would break.
+  #pending = $state.raw<Pending[]>([]);
+  loading = $state(true);
+
+  constructor(target: AnnotationTarget) {
+    this.#target = target;
+    this.#stores = serverRegistry.tryGetStore(target.serverId);
+    // An image inside a thread is annotated in that thread; otherwise the
+    // image message becomes the thread root.
+    const image = this.#stores?.rooms.messages(target.roomId).getEventById(target.eventId);
+    this.#threadRootEventId =
+      (image && isMessagePostedEvent(image.event) ? image.event.threadRootEventId : null) ||
+      target.eventId;
+    if (!this.#stores) return;
+    this.#thread = this.#stores.rooms.thread(target.roomId, this.#threadRootEventId);
+    void this.#loadAll();
+  }
+
+  async #loadAll(): Promise<void> {
+    const thread = this.#thread!;
+    try {
+      await thread.restoreLatestWindow();
+      for (let page = 0; page < MAX_PAGES && !thread.hasReachedStart && !this.#disposed; page++) {
+        await thread.loadMore();
+      }
+    } catch (error) {
+      console.warn('[annotations] thread unavailable:', error);
+    } finally {
+      this.loading = false;
+    }
+  }
+
+  dispose(): void {
+    this.#disposed = true;
+  }
+
+  get viewerId(): string | null {
+    return this.#stores?.accountId ?? null;
+  }
+
+  /** Whether the viewer may add annotations (needs thread replies in this room). */
+  get canAnnotate(): boolean {
+    if (!this.viewerId || !this.#thread) return false;
+    const root = this.#thread.threadEvents.find((e) => e.id === this.#threadRootEventId);
+    return !root || !isMessagePostedEvent(root.event) || root.event.canReplyInThread !== false;
+  }
+
+  /** Annotation messages of this image in posting order, then unconfirmed ones. */
+  get #entries(): Entry[] {
+    const posted: Entry[] = [];
+    for (const entry of this.#thread?.threadEvents ?? []) {
+      const event = entry.event;
+      if (!isMessagePostedEvent(event) || event.deletedAt || !entry.actorId) continue;
+      const parsed = parseAnnotation(event.body);
+      if (!parsed || parsed.assetId !== this.#target.assetId) continue;
+      posted.push({
+        eventId: entry.id,
+        authorId: entry.actorId,
+        createdAt: entry.createdAt,
+        shape: parsed.shape,
+        movedEventId: parsed.movedEventId,
+        marker: annotationMarker(parsed.assetId, parsed.shape, parsed.movedEventId ?? undefined)
+      });
+    }
+    posted.sort((a, b) => a.createdAt.localeCompare(b.createdAt));
+    const confirmed = new Set(posted.map((e) => e.marker));
+    const pending = this.#pending
+      .filter((p) => !confirmed.has(p.marker))
+      .map((p) => ({ ...p, eventId: '', authorId: this.viewerId ?? '' }));
+    return [...posted, ...pending];
+  }
+
+  /**
+   * Annotations in posting order, each at its latest position. Colour and pin
+   * number stay with the original annotation, whoever moved it.
+   */
+  get annotations(): Annotation[] {
+    const annotations: Annotation[] = [];
+    const byEventId = new Map<string, number>();
+    for (const entry of this.#entries) {
+      if (entry.movedEventId) {
+        const index = byEventId.get(entry.movedEventId);
+        const original = index === undefined ? undefined : annotations[index];
+        if (original && original.type === entry.shape.type) {
+          annotations[index!] = { ...original, ...entry.shape };
+        }
+        continue;
+      }
+      if (entry.eventId) byEventId.set(entry.eventId, annotations.length);
+      annotations.push({
+        ...entry.shape,
+        eventId: entry.eventId,
+        authorId: entry.authorId,
+        createdAt: entry.createdAt
+      });
+    }
+    return annotations;
+  }
+
+  /** Whether the viewer may delete this annotation: their own, or any as a moderator. */
+  canDelete(eventId: string | null): boolean {
+    const annotation = eventId ? this.annotations.find((a) => a.eventId === eventId) : null;
+    if (!annotation || !this.viewerId) return false;
+    if (annotation.authorId === this.viewerId) return true;
+    const state = this.#stores?.projection.rooms.get(this.#target.roomId)?.viewerState;
+    return !!state?.permissions.some((p) => p.permission === 'message.manage' && p.granted);
+  }
+
+  /** Delete an annotation; its moves are ignored from then on. */
+  async delete(eventId: string): Promise<void> {
+    await serverConnectionManager
+      .getClient(this.#target.serverId)
+      .getAPI(createMessageAPI)
+      .deleteMessage(this.#target.roomId, eventId);
+    this.#thread?.applyLocalMessageDeletion(eventId);
+  }
+
+  /** Whether the viewer has a posted annotation or move to take back. */
+  get canUndo(): boolean {
+    return this.#entries.some((e) => e.eventId && e.authorId === this.viewerId);
+  }
+
+  /** One colour per annotating user (and the viewer, for drawing previews). */
+  get colors(): Map<string, string> {
+    const ids = this.annotations.map((a) => a.authorId);
+    if (this.viewerId) ids.push(this.viewerId);
+    return assignColors(ids);
+  }
+
+  /** Annotating users with their colour, for the legend. */
+  get authors(): { id: string; name: string; color: string }[] {
+    const names = new Map<string, string>();
+    for (const entry of this.#thread?.threadEvents ?? []) {
+      if (entry.actorId && entry.actor) names.set(entry.actorId, entry.actor.displayName);
+    }
+    const colors = this.colors;
+    return [...new Set(this.annotations.map((a) => a.authorId))].map((id) => ({
+      id,
+      name: names.get(id) ?? '…',
+      color: colors.get(id) ?? '#888'
+    }));
+  }
+
+  /** Post one annotation as a thread reply; `label` is the visible text. */
+  add(shape: AnnotationShape, label: string): Promise<void> {
+    return this.#post(shape, label, null);
+  }
+
+  /** Move a posted annotation (anyone's) to a new shape. */
+  move(annotation: Annotation, shape: AnnotationShape, label: string): Promise<void> {
+    if (!annotation.eventId) return Promise.resolve();
+    return this.#post(shape, label, annotation.eventId);
+  }
+
+  async #post(shape: AnnotationShape, label: string, movedEventId: string | null) {
+    const marker = annotationMarker(this.#target.assetId, shape, movedEventId ?? undefined);
+    const pending: Pending = { shape, marker, createdAt: new Date().toISOString(), movedEventId };
+    this.#pending = [...this.#pending, pending];
+    try {
+      const { event } = await serverConnectionManager
+        .getClient(this.#target.serverId)
+        .getAPI(createMessageAPI)
+        .createMessage({
+          roomId: this.#target.roomId,
+          body: `${label} ${marker}`,
+          threadRootEventId: this.#threadRootEventId
+        });
+      // Show the confirmed message now; the realtime echo is deduplicated. A
+      // placeholder kept longer would reappear if the annotation is deleted.
+      if (event) this.#thread?.ingestEvent(event);
+    } finally {
+      this.#pending = this.#pending.filter((p) => p !== pending);
+    }
+  }
+
+  /** Retract the viewer's most recent annotation or move on this image. */
+  async undoLast(): Promise<boolean> {
+    const last = this.#entries.filter((e) => e.eventId && e.authorId === this.viewerId).at(-1);
+    if (!last) return false;
+    await serverConnectionManager
+      .getClient(this.#target.serverId)
+      .getAPI(createMessageAPI)
+      .deleteMessage(this.#target.roomId, last.eventId);
+    this.#thread?.applyLocalMessageDeletion(last.eventId);
+    return true;
+  }
+}
