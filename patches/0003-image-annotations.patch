@@ -0,0 +1,109 @@
+<!-- @component
+Annotation controls in the image viewer's bottom bar: tool choice, undo of the
+viewer's last annotation, show/hide, and a colour legend of the annotators.
+-->
+<script lang="ts">
+  import { m } from '$lib/i18n/messages';
+  import type { AnnotationTool } from './annotationSpec';
+
+  let {
+    tool = $bindable(),
+    visible = $bindable(),
+    canAnnotate,
+    canUndo,
+    canDelete,
+    authors,
+    onundo,
+    ondelete
+  }: {
+    tool: AnnotationTool;
+    visible: boolean;
+    canAnnotate: boolean;
+    canUndo: boolean;
+    authors: { id: string; name: string; color: string }[];
+    onundo: () => void;
+    /** Deletes the selected annotation. */
+    canDelete: boolean;
+    ondelete: () => void;
+  } = $props();
+
+  const tools = $derived([
+    { value: 'view', icon: 'icon-[lucide--hand]', label: m('annotations.tool_view') },
+    { value: 'pin', icon: 'icon-[lucide--map-pin]', label: m('annotations.tool_pin') },
+    { value: 'hl', icon: 'icon-[lucide--highlighter]', label: m('annotations.tool_highlight') }
+  ] satisfies { value: AnnotationTool; icon: string; label: string }[]);
+</script>
+
+<div
+  class="flex flex-wrap items-center justify-center gap-1 sm:ms-3 sm:border-s sm:border-white/25 sm:ps-3"
+>
+  {#if canAnnotate}
+    <div class="flex items-center gap-1" role="radiogroup" aria-label={m('annotations.tools')}>
+      {#each tools as option (option.value)}
+        <button
+          type="button"
+          role="radio"
+          aria-checked={tool === option.value}
+          class={['icon-action rounded text-white', tool === option.value && 'bg-white/25']}
+          aria-label={option.label}
+          title={option.label}
+          onclick={() => {
+            tool = option.value;
+            if (option.value !== 'view') visible = true;
+          }}
+        >
+          <span class={['iconify text-xl', option.icon]} aria-hidden="true"></span>
+        </button>
+      {/each}
+    </div>
+    <button
+      type="button"
+      class="icon-action text-white"
+      aria-label={m('annotations.undo')}
+      title={m('annotations.undo')}
+      disabled={!canUndo}
+      onclick={onundo}
+    >
+      <span class="iconify icon-[uil--redo] -scale-x-100 text-xl" aria-hidden="true"></span>
+    </button>
+    <button
+      type="button"
+      class="icon-action text-white"
+      aria-label={m('annotations.delete')}
+      title={m('annotations.delete')}
+      disabled={!canDelete}
+      onclick={ondelete}
+    >
+      <span class="iconify icon-[lucide--trash-2] text-xl" aria-hidden="true"></span>
+    </button>
+  {/if}
+  {#if authors.length}
+    <button
+      type="button"
+      class="icon-action text-white"
+      aria-label={visible ? m('annotations.hide') : m('annotations.show')}
+      title={visible ? m('annotations.hide') : m('annotations.show')}
+      aria-pressed={!visible}
+      onclick={() => {
+        visible = !visible;
+        if (!visible) tool = 'view';
+      }}
+    >
+      <span
+        class={['iconify text-xl', visible ? 'icon-[uil--eye]' : 'icon-[uil--eye-slash]']}
+        aria-hidden="true"
+      ></span>
+    </button>
+    <ul class="flex max-w-64 items-center gap-2 overflow-hidden text-xs">
+      {#each authors as author (author.id)}
+        <li class="flex min-w-0 items-center gap-1" title={author.name}>
+          <span
+            class="size-2.5 shrink-0 rounded-full ring-1 ring-white/70"
+            style:background={author.color}
+          ></span>
+          <span class="truncate">{author.name}</span>
+        </li>
+      {/each}
+    </ul>
+  {/if}
+</div>
diff --git a/apps/frontend/src/lib/annotations/annotationSpec.ts b/apps/frontend/src/lib/annotations/annotationSpec.ts
new file mode 100644
index 000000000..5ae32de3b
--- /dev/null
+++ b/apps/frontend/src/lib/annotations/annotationSpec.ts
@@ -0,0 +1,180 @@
+/**
+ * Image annotations stored as messages.
+ *
+ * Chatto messages carry no structured metadata, so every annotation is a reply
+ * in the thread of the image message whose body ends with a marker link:
+ *
+ *   📍 3 [⌖](#chatto-annot:v1:<assetId>:pin:<x>,<y>)
+ *   🖍️ [⌖](#chatto-annot:v1:<assetId>:hl:<x>,<y>;<x>,<y>;…)
+ *
+ * Moving an annotation posts its new shape with the event ID of the original;
+ * the latest move wins, and retracting it restores the previous position:
+ *
+ *   ↔️ 📍 3 [⌖](#chatto-annot:v1:<assetId>:mv:<eventId>:pin:<x>,<y>)
+ *
+ * Coordinates are integers 0…10000 relative to the image width and height, so
+ * they do not depend on which rendition of the image is shown. Pin numbers are
+ * not stored: pins count up in the order they were posted.
+ */
+
+export const ANNOTATION_MARKER_PREFIX = '#chatto-annot:v1:';
+
+/** Coordinate resolution: 0…SCALE maps to 0…1 of the image. */
+const SCALE = 10000;
+/** Highlighter strokes keep at most this many points after simplification. */
+export const MAX_STROKE_POINTS = 400;
+
+export type Point = { x: number; y: number };
+
+/** Viewer tool: look (pan and zoom), place pins, or highlight. Any tool moves annotations. */
+export type AnnotationTool = 'view' | 'pin' | 'hl';
+
+export type AnnotationShape = { type: 'pin'; at: Point } | { type: 'hl'; points: Point[] };
+
+export type Annotation = AnnotationShape & {
+  eventId: string;
+  authorId: string;
+  createdAt: string;
+};
+
+const ID = '[A-Za-z0-9_-]{1,64}';
+const MARKER_IN_BODY = new RegExp(
+  `\\]\\(#chatto-annot:v1:(${ID}):(?:mv:(${ID}):)?(pin|hl):([0-9,;]{3,6000})\\)`
+);
+const HREF = new RegExp(`^#chatto-annot:v1:${ID}:(?:mv:${ID}:)?(?:pin|hl):[0-9,;]{3,6000}$`);
+
+const clampUnit = (value: number) => Math.min(1, Math.max(0, value));
+const encodePoint = (p: Point) =>
+  `${Math.round(clampUnit(p.x) * SCALE)},${Math.round(clampUnit(p.y) * SCALE)}`;
+
+function decodePoint(text: string): Point | null {
+  const [x, y, extra] = text.split(',');
+  if (extra !== undefined || !/^\d{1,5}$/.test(x ?? '') || !/^\d{1,5}$/.test(y ?? '')) return null;
+  const px = Number(x) / SCALE;
+  const py = Number(y) / SCALE;
+  return px <= 1 && py <= 1 ? { x: px, y: py } : null;
+}
+
+/** Whether a link href is an annotation marker (rendered invisibly). */
+export function isAnnotationHref(href: string): boolean {
+  return HREF.test(href);
+}
+
+/**
+ * Marker link for one annotation of an image asset. With `movedEventId` it
+ * moves that earlier annotation to `shape` instead of adding one.
+ */
+export function annotationMarker(
+  assetId: string,
+  shape: AnnotationShape,
+  movedEventId?: string
+): string {
+  const data =
+    shape.type === 'pin' ? encodePoint(shape.at) : shape.points.map(encodePoint).join(';');
+  const move = movedEventId ? `mv:${movedEventId}:` : '';
+  return `[⌖](${ANNOTATION_MARKER_PREFIX}${assetId}:${move}${shape.type}:${data})`;
+}
+
+export type ParsedAnnotation = {
+  assetId: string;
+  shape: AnnotationShape;
+  /** Set when the message moves an earlier annotation. */
+  movedEventId: string | null;
+};
+
+/** The annotation of a message body, or null when it has none. */
+export function parseAnnotation(body: string | null | undefined): ParsedAnnotation | null {
+  if (!body || !body.includes(ANNOTATION_MARKER_PREFIX)) return null;
+  const match = MARKER_IN_BODY.exec(body);
+  if (!match) return null;
+  const [, assetId, moved, type, data] = match;
+  const movedEventId = moved ?? null;
+  if (type === 'pin') {
+    const at = decodePoint(data);
+    return at ? { assetId, shape: { type: 'pin', at }, movedEventId } : null;
+  }
+  const points = data.split(';').map(decodePoint);
+  if (points.length < 2 || points.length > MAX_STROKE_POINTS || points.some((p) => !p)) return null;
+  return { assetId, shape: { type: 'hl', points: points as Point[] }, movedEventId };
+}
+
+/** The shape moved by an offset in normalized coordinates, kept on the image. */
+export function translateShape(shape: AnnotationShape, dx: number, dy: number): AnnotationShape {
+  const move = (p: Point) => ({ x: clampUnit(p.x + dx), y: clampUnit(p.y + dy) });
+  return shape.type === 'pin'
+    ? { type: 'pin', at: move(shape.at) }
+    : { type: 'hl', points: shape.points.map(move) };
+}
+
+/** Ramer–Douglas–Peucker simplification in normalized image coordinates. */
+export function simplifyStroke(points: Point[], tolerance = 0.002): Point[] {
+  if (points.length <= 2) return points;
+  const keep = new Uint8Array(points.length);
+  keep[0] = keep[points.length - 1] = 1;
+  const stack: [number, number][] = [[0, points.length - 1]];
+  while (stack.length) {
+    const [first, last] = stack.pop()!;
+    const a = points[first];
+    const b = points[last];
+    const length = Math.hypot(b.x - a.x, b.y - a.y) || 1e-9;
+    let worst = -1;
+    let worstDistance = tolerance;
+    for (let i = first + 1; i < last; i++) {
+      const p = points[i];
+      const distance = Math.abs((b.x - a.x) * (a.y - p.y) - (a.x - p.x) * (b.y - a.y)) / length;
+      if (distance > worstDistance) {
+        worst = i;
+        worstDistance = distance;
+      }
+    }
+    if (worst > 0) {
+      keep[worst] = 1;
+      stack.push([first, worst], [worst, last]);
+    }
+  }
+  const simplified = points.filter((_, i) => keep[i]);
+  if (simplified.length <= MAX_STROKE_POINTS) return simplified;
+  const step = simplified.length / MAX_STROKE_POINTS;
+  return Array.from({ length: MAX_STROKE_POINTS }, (_, i) => simplified[Math.floor(i * step)]);
+}
+
+/** Distinct, saturated colours that read on light and dark images. */
+export const ANNOTATION_COLORS = [
+  '#e6194b',
+  '#3cb44b',
+  '#ffe119',
+  '#4363d8',
+  '#f58231',
+  '#911eb4',
+  '#42d4f4',
+  '#f032e6',
+  '#bfef45',
+  '#fabed4',
+  '#469990',
+  '#9a6324'
+] as const;
+
+function hash(text: string): number {
+  let h = 2166136261;
+  for (let i = 0; i < text.length; i++) h = Math.imul(h ^ text.charCodeAt(i), 16777619);
+  return h >>> 0;
+}
+
+/**
+ * Colour per user. Each user prefers the colour their ID hashes to, so it is
+ * the same on every image; when two users on one image collide, the later ID
+ * in sort order moves to the next free colour.
+ */
+export function assignColors(userIds: Iterable<string>): Map<string, string> {
+  const colors = new Map<string, string>();
+  const taken = new Set<number>();
+  for (const id of [...new Set(userIds)].sort()) {
+    let index = hash(id) % ANNOTATION_COLORS.length;
+    for (let tries = 0; taken.has(index) && tries < ANNOTATION_COLORS.length; tries++) {
+      index = (index + 1) % ANNOTATION_COLORS.length;
+    }
+    taken.add(index);
+    colors.set(id, ANNOTATION_COLORS[index]);
+  }
+  return colors;
+}
