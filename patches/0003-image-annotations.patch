+package core
+
+import "strings"
+
+// imageAnnotationMarker starts the marker link that the web client's image
+// annotations (lizzard fork patch) append to a thread reply.
+const imageAnnotationMarker = "](#chatto-annot:v1:"
+
+// diceMarker starts the marker links that dice bots such as Pantheon append to
+// their replies (`#chatto-dice:`, `#chatto-dice-note:`, `#chatto-dice-system:`).
+const diceMarker = "](#chatto-dice"
+
+// isQuietThreadReply reports whether a thread reply is bookkeeping that must not
+// make anyone follow the thread: an image annotation, a dice bot reply, or a bot
+// command such as `!r 2d6`. Posting one does not auto-follow the thread for the
+// poster or the root's author, so a dice collection thread or the annotations
+// of an image cause no thread notifications by themselves.
+func isQuietThreadReply(body string) bool {
+	return strings.Contains(body, imageAnnotationMarker) ||
+		strings.Contains(body, diceMarker) ||
+		strings.HasPrefix(strings.TrimSpace(body), "!")
+}
