diff --git a/apps/frontend/src/lib/annotations/AnnotationLayer.svelte b/apps/frontend/src/lib/annotations/AnnotationLayer.svelte
new file mode 100644
index 000000000..0103f8a54
--- /dev/null
+++ b/apps/frontend/src/lib/annotations/AnnotationLayer.svelte
@@ -0,0 +1,324 @@
+<!-- @component
+SVG layer over a zoomable image. It shares the image's box and transform, so
+annotations stay on their spot while the viewer zooms and pans. With a drawing
+tool active it takes the pointer and reports new shapes in normalized image
+coordinates (0…1).
+
+Tapping or clicking an annotation selects it and shows a bounding box with
+corner anchors; dragging it (or its box) moves it, with any tool. Only the
+highlighter keeps drawing over unselected highlights. Elsewhere the image pans
+as usual.
+-->
+<script lang="ts">
+  import type { Annotation, AnnotationShape, AnnotationTool, Point } from './annotationSpec';
+  import { simplifyStroke, translateShape } from './annotationSpec';
+
+  let {
+    annotations,
+    colors,
+    viewerColor,
+    width,
+    height,
+    pxPerUnit,
+    transform,
+    tool,
+    onpin,
+    onstroke,
+    onmove,
+    selected = $bindable(null)
+  }: {
+    annotations: Annotation[];
+    colors: Map<string, string>;
+    viewerColor: string;
+    /** Natural size of the shown image rendition. */
+    width: number;
+    height: number;
+    /** Screen pixels per image pixel at the current zoom. */
+    pxPerUnit: number;
+    /** The CSS transform of the image. */
+    transform: string;
+    tool: AnnotationTool;
+    onpin: (at: Point) => void;
+    onstroke: (points: Point[]) => void;
+    onmove: (annotation: Annotation, shape: AnnotationShape) => void;
+    /** Event ID of the selected annotation; the owner deletes it. */
+    selected?: string | null;
+  } = $props();
+
+  let svg: SVGSVGElement;
+  let drawing = $state<Point[] | null>(null);
+  let pressed: { x: number; y: number; id: number } | null = null;
+  /** The annotation under the pointer since pointerdown, and how far it moved. */
+  let dragging = $state<{ index: number; start: Point; dx: number; dy: number } | null>(null);
+
+  const drawingTool = $derived(tool === 'pin' || tool === 'hl');
+
+  /** Screen-sized things (pins, frames) are scaled by this to stay the same size at any zoom. */
+  const unit = $derived(pxPerUnit > 0 ? 1 / pxPerUnit : 1);
+  /** Highlighter width belongs to the image: 2.5 % of its shorter side. */
+  const strokeWidth = $derived(Math.min(width, height) * 0.025);
+
+  /** Pins count up in posting order; entry i belongs to annotations[i]. */
+  const pinNumbers = $derived.by(() => {
+    let next = 0;
+    return annotations.map((annotation) => (annotation.type === 'pin' ? ++next : 0));
+  });
+
+  const selectedIndex = $derived(
+    selected ? annotations.findIndex((a) => a.eventId === selected) : -1
+  );
+
+  function toImage(event: PointerEvent, onImage = true): Point | null {
+    const matrix = svg.getScreenCTM();
+    if (!matrix || !width || !height) return null;
+    const p = new DOMPoint(event.clientX, event.clientY).matrixTransform(matrix.inverse());
+    if (onImage && (p.x < 0 || p.y < 0 || p.x > width || p.y > height)) return null;
+    return { x: p.x / width, y: p.y / height };
+  }
+
+  /** The shape to draw: a dragged annotation follows the pointer. */
+  function shown(annotation: Annotation, index: number): Annotation {
+    if (dragging?.index !== index) return annotation;
+    return { ...annotation, ...translateShape(annotation, dragging.dx, dragging.dy) };
+  }
+
+  /** Bounding box in image pixels, padded by a few screen pixels. */
+  function bounds(annotation: Annotation) {
+    const pad = 6 * unit;
+    if (annotation.type === 'pin') {
+      const x = annotation.at.x * width;
+      const y = annotation.at.y * height;
+      return {
+        x: x - 16 * unit - pad,
+        y: y - 41 * unit - pad,
+        w: 32 * unit + 2 * pad,
+        h: 43 * unit + 2 * pad
+      };
+    }
+    const xs = annotation.points.map((p) => p.x * width);
+    const ys = annotation.points.map((p) => p.y * height);
+    const half = strokeWidth / 2 + pad;
+    const x = Math.min(...xs) - half;
+    const y = Math.min(...ys) - half;
+    return { x, y, w: Math.max(...xs) + half - x, h: Math.max(...ys) + half - y };
+  }
+
+  function pointerdown(event: PointerEvent) {
+    if (event.pointerType === 'mouse' && event.button !== 0) return;
+    const grabbed = (event.target as Element).closest('[data-annotation]');
+    const index = grabbed ? Number(grabbed.getAttribute('data-annotation')) : -1;
+    const annotation = annotations[index];
+    // The highlighter draws over highlights that are not selected.
+    const grab =
+      annotation?.eventId &&
+      !(tool === 'hl' && annotation.eventId !== selected && annotation.type === 'hl');
+    if (grab) {
+      const start = toImage(event, false);
+      if (!start) return;
+      event.stopPropagation();
+      event.preventDefault();
+      svg.setPointerCapture(event.pointerId);
+      pressed = { x: event.clientX, y: event.clientY, id: event.pointerId };
+      dragging = { index, start, dx: 0, dy: 0 };
+      return;
+    }
+    selected = null;
+    // Without a drawing tool the stage pans and zooms (the event reaches it).
+    if (!drawingTool) return;
+    event.stopPropagation();
+    event.preventDefault();
+    const point = toImage(event);
+    if (!point) return;
+    svg.setPointerCapture(event.pointerId);
+    pressed = { x: event.clientX, y: event.clientY, id: event.pointerId };
+    if (tool === 'hl') drawing = [point];
+  }
+
+  function pointermove(event: PointerEvent) {
+    if (pressed?.id !== event.pointerId) return;
+    if (dragging) {
+      event.stopPropagation();
+      const point = toImage(event, false);
+      if (point)
+        dragging = { ...dragging, dx: point.x - dragging.start.x, dy: point.y - dragging.start.y };
+      return;
+    }
+    if (!drawing) return;
+    event.stopPropagation();
+    const point = toImage(event);
+    if (point) drawing = [...drawing, point];
+  }
+
+  function pointerup(event: PointerEvent) {
+    if (pressed?.id !== event.pointerId) return;
+    event.stopPropagation();
+    const moved = Math.hypot(event.clientX - pressed.x, event.clientY - pressed.y);
+    pressed = null;
+    if (dragging) {
+      const annotation = annotations[dragging.index];
+      if (annotation && moved >= 4) {
+        onmove(annotation, translateShape(annotation, dragging.dx, dragging.dy));
+      }
+      if (annotation) selected = annotation.eventId;
+      dragging = null;
+      return;
+    }
+    if (tool === 'pin' && moved < 8) {
+      const point = toImage(event);
+      if (point) onpin(point);
+    } else if (tool === 'hl' && drawing && drawing.length > 1) {
+      onstroke(simplifyStroke(drawing));
+    }
+    drawing = null;
+  }
+
+  function cancel() {
+    pressed = null;
+    drawing = null;
+    dragging = null;
+  }
+
+  function path(points: Point[]): string {
+    return points
+      .map((p, i) => `${i ? 'L' : 'M'}${(p.x * width).toFixed(1)} ${(p.y * height).toFixed(1)}`)
+      .join('');
+  }
+</script>
+
+{#snippet highlight(points: Point[], color: string, grab?: number)}
+  <!-- Dark halo first, then the colour: readable on bright and dark images.
+       The halo is also what a pointer grabs. -->
+  <path
+    data-annotation={grab}
+    class:annotation-grab={grab !== undefined}
+    d={path(points)}
+    fill="none"
+    stroke="black"
+    stroke-opacity="0.35"
+    stroke-width={strokeWidth + 4 * unit}
+    stroke-linecap="round"
+    stroke-linejoin="round"
+  />
+  <path
+    d={path(points)}
+    fill="none"
+    stroke={color}
+    stroke-opacity="0.55"
+    stroke-width={strokeWidth}
+    stroke-linecap="round"
+    stroke-linejoin="round"
+    pointer-events="none"
+  />
+{/snippet}
+
+<svg
+  bind:this={svg}
+  viewBox={`0 0 ${width || 1} ${height || 1}`}
+  preserveAspectRatio="xMidYMid meet"
+  class="pointer-events-none absolute inset-0 h-full w-full overflow-visible"
+  class:annotation-drawing={drawingTool || selected !== null}
+  style:transform
+  style:cursor={drawingTool ? 'crosshair' : undefined}
+  role="presentation"
+  onpointerdown={pointerdown}
+  onpointermove={pointermove}
+  onpointerup={pointerup}
+  onpointercancel={cancel}
+  ondblclick={(event) => (drawingTool || dragging) && event.stopPropagation()}
+>
+  {#each annotations as original, index (original.eventId || original.createdAt)}
+    {@const annotation = shown(original, index)}
+    {@const color = colors.get(annotation.authorId) ?? viewerColor}
+    {@const grab = annotation.eventId ? index : undefined}
+    {#if annotation.type === 'hl'}
+      {@render highlight(annotation.points, color, grab)}
+    {:else}
+      <g
+        transform={`translate(${annotation.at.x * width} ${annotation.at.y * height}) scale(${unit})`}
+        opacity={annotation.eventId ? 1 : 0.6}
+        data-annotation={grab}
+        class:annotation-grab={grab !== undefined}
+      >
+        <!-- Map pin with its tip on the point. -->
+        <path
+          d="M0 0 C-4 -9 -14 -14 -14 -25 A14 14 0 1 1 14 -25 C14 -14 4 -9 0 0 Z"
+          fill={color}
+          stroke="white"
+          stroke-width="2.5"
+          style="filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.6))"
+        />
+        <text
+          y="-25"
+          text-anchor="middle"
+          dominant-baseline="central"
+          font-size="15"
+          font-weight="700"
+          fill="white"
+          stroke="black"
+          stroke-width="3"
+          paint-order="stroke"
+          font-family="system-ui, sans-serif">{pinNumbers[index]}</text
+        >
+      </g>
+    {/if}
+  {/each}
+  {#if selectedIndex >= 0}
+    {@const box = bounds(shown(annotations[selectedIndex], selectedIndex))}
+    {@const anchor = 7 * unit}
+    <!-- Selection frame: the whole box can be dragged. -->
+    <g data-annotation={selectedIndex} class="annotation-grab annotation-selection">
+      <rect
+        x={box.x}
+        y={box.y}
+        width={box.w}
+        height={box.h}
+        fill="white"
+        fill-opacity="0.06"
+        stroke="black"
+        stroke-opacity="0.6"
+        stroke-width={3 * unit}
+      />
+      <rect
+        x={box.x}
+        y={box.y}
+        width={box.w}
+        height={box.h}
+        fill="none"
+        stroke="white"
+        stroke-width={1.5 * unit}
+        stroke-dasharray={`${5 * unit} ${4 * unit}`}
+      />
+      {#each [[box.x, box.y], [box.x + box.w, box.y], [box.x, box.y + box.h], [box.x + box.w, box.y + box.h]] as [cx, cy], corner (corner)}
+        <rect
+          x={cx - anchor / 2}
+          y={cy - anchor / 2}
+          width={anchor}
+          height={anchor}
+          fill="white"
+          stroke="black"
+          stroke-width={1.5 * unit}
+        />
+      {/each}
+    </g>
+  {/if}
+  {#if drawing && drawing.length > 1}
+    {@render highlight(drawing, viewerColor)}
+  {/if}
+</svg>
+
+<style>
+  .annotation-drawing {
+    pointer-events: auto;
+    touch-action: none;
+  }
+
+  .annotation-grab {
+    pointer-events: auto;
+    touch-action: none;
+    cursor: grab;
+  }
+
+  .annotation-selection {
+    cursor: move;
+  }
+</style>
