+package core
+
+import "testing"
+
+func TestIsQuietThreadReply(t *testing.T) {
+	quiet := []string{
+		"↔️ 📍 0 [⌖](#chatto-annot:v1:A1:pin:10,20)",
+		"**Simon** 🎲 **7** — d6+d8 [🎲](#chatto-dice:std.6.1,std.8.6;by=U1)",
+		"❌ Zu viele Würfel [​](#chatto-dice-note:by=U1)",
+		"!r 2d6",
+		"  !dice",
+	}
+	for _, body := range quiet {
+		if !isQuietThreadReply(body) {
+			t.Errorf("isQuietThreadReply(%q) = false, want true", body)
+		}
+	}
+	for _, body := range []string{"Gute Idee!", "Wer würfelt? !r kommt gleich", "[Karte](https://example.com/#chatto-embed)"} {
+		if isQuietThreadReply(body) {
+			t.Errorf("isQuietThreadReply(%q) = true, want false", body)
+		}
+	}
+}
