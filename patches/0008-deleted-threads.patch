From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Phil Reif <pr@sambal.net>
Date: Thu, 22 Oct 2026 15:45:58 +0200
Subject: [PATCH] fix(frontend): hide deleted threads without replies on the
 Threads page

The Threads page listed followed threads whose root is deleted and that
have no replies left, as "Message deleted". The page now omits them.

(The room timeline part is fixed upstream by #3132.)
---
 .../src/routes/chat/[serverId]/threads/+page.svelte      | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/apps/frontend/src/routes/chat/[serverId]/threads/+page.svelte b/apps/frontend/src/routes/chat/[serverId]/threads/+page.svelte
index 613bc2dc6..23f31d55d 100644
--- a/apps/frontend/src/routes/chat/[serverId]/threads/+page.svelte
+++ b/apps/frontend/src/routes/chat/[serverId]/threads/+page.svelte
@@ -187,10 +187,17 @@
   );
   const hasMore = $derived(threadsQuery.hasNextPage);
 
+  // A deleted root whose replies are all deleted too has nothing left to open;
+  // the server keeps listing it as long as someone follows it.
+  const isEmptyDeletedThread = (thread: FollowedThread) =>
+    thread.replyCount === 0 &&
+    thread.rootMessage?.event.kind === 'messagePosted' &&
+    Boolean(thread.rootMessage.event.deletedAt);
+
   // Also filter server-filtered pages so that a thread marked as read leaves the
   // unread view at once, before the next refetch.
   const filteredThreads = $derived(
-    filter === 'unread' ? threads.filter((t) => t.hasUnreadReplies) : threads
+    threads.filter((t) => !isEmptyDeletedThread(t) && (filter !== 'unread' || t.hasUnreadReplies))
   );
   const dateSections = $derived.by(() => {
     const sortDate = (thread: FollowedThread) =>
-- 
