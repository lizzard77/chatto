   // Also filter server-filtered pages so that a thread marked as read leaves the
   // unread view at once, before the next refetch.
   const filteredThreads = $derived(
-    filter === 'unread' ? threads.filter((t) => t.hasUnreadReplies) : threads
+    threads.filter((t) => !isEmptyDeletedThread(t) && (filter !== 'unread' || t.hasUnreadReplies))
   );
   const dateSections = $derived.by(() => {
     const sortDate = (thread: FollowedThread) =>
diff --git a/packages/chatto-client/src/room/messages/MessagesStore.spec.ts b/packages/chatto-client/src/room/messages/MessagesStore.spec.ts
index 50eb867a2..742819155 100644
--- a/packages/chatto-client/src/room/messages/MessagesStore.spec.ts
+++ b/packages/chatto-client/src/room/messages/MessagesStore.spec.ts
@@ -925,6 +925,49 @@ describe('MessagesStore — room lifecycle ownership', () => {
     store.dispose();
