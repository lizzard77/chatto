+  it('reads the reply count of loaded deleted thread roots again', async () => {
+    vi.useFakeTimers();
+    const base = threadMessageEvent('root1');
+    const root = {
+      ...base,
+      event: { ...base.event, body: null, deletedAt: '2026-05-27T00:00:05Z', replyCount: 2 }
+    };
+    const emptied = { ...root, event: { ...root.event, replyCount: 0 } };
+    const around = (event: unknown): EventConnectionPage => ({
+      events: [event as never],
+      startCursor: 'tl:root1',
+      endCursor: 'tl:root1',
+      hasOlder: false,
+      hasNewer: false
+    });
+    const getRoomEventsAround = vi
+      .fn<RoomTimelineAPI['getRoomEventsAround']>()
+      .mockResolvedValueOnce(around(root))
+      .mockResolvedValue(around(emptied));
+    const store = new MessagesStore(
+      new FakeQueryClient() as unknown as ServerConnection,
+      () => null,
+      { roomId: 'room-1' },
+      fakeTimelineAPI({ getRoomEventsAround })
+    );
+    await store.jumpToMessage('root1');
+    const replyCount = () => {
+      const event = store.rootEvents.find((row) => row.id === 'root1')?.event;
+      return event && 'replyCount' in event ? event.replyCount : undefined;
+    };
+    expect(replyCount()).toBe(2);
+
+    // Retractions in quick succession share one read.
+    store.refreshDeletedThreadRoots();
+    store.refreshDeletedThreadRoots();
+    await vi.advanceTimersByTimeAsync(300);
+
+    expect(getRoomEventsAround).toHaveBeenCalledTimes(2);
+    expect(replyCount()).toBe(0);
+    vi.useRealTimers();
+    store.dispose();
+  });
+
   it('keeps an in-flight message jump when lazy latest-page hydration arrives', async () => {
     const fake = new FakeQueryClient();
     type AroundPage = Awaited<ReturnType<RoomTimelineAPI['getRoomEventsAround']>>;
