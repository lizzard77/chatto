@@ -370,6 +372,49 @@ export class MessagesStore {
     this.applyDeletion(messageEventId, retractedAt);
   }
 
+  #deletedRootRefresh: ReturnType<typeof setTimeout> | null = null;
+
+  /**
+   * Read the reply count of loaded deleted thread roots again, shortly after the
+   * last call. A room timeline does not see reply retractions, and the server
+   * omits deleted messages from message reads, so only the room page around the
+   * root has the current count. A root without replies then leaves the timeline
+   * as a context-free tombstone.
+   */
+  refreshDeletedThreadRoots(): void {
+    if (this.scope !== 'room') return;
+    if (this.#deletedRootRefresh) clearTimeout(this.#deletedRootRefresh);
+    this.#deletedRootRefresh = setTimeout(() => {
+      this.#deletedRootRefresh = null;
+      void this.readDeletedThreadRootCounts();
+    }, 300);
+  }
+
+  private async readDeletedThreadRootCounts(): Promise<void> {
+    const ids = this.events
+      .filter(
+        (row) =>
+          isMessagePostedPayload(row.event) && row.event.deletedAt && row.event.replyCount > 0
+      )
+      .map((row) => row.id);
+    for (const id of ids) {
+      let fresh: TimelineEventView | undefined;
+      try {
+        const page = await this.source.fetchAround(id, 1, null);
+        fresh = this.unmaskEvents(page.events).find((event) => event.id === id);
+      } catch {
+        continue;
+      }
+      if (!fresh || !isMessagePostedPayload(fresh.event)) continue;
+      const replyCount = fresh.event.replyCount;
+      const index = this.events.findIndex((event) => event.id === id);
+      const row = this.events[index];
+      if (!row || !isMessagePostedPayload(row.event) || row.event.replyCount === replyCount)
+        continue;
+      this.events = this.events.with(index, { ...row, event: { ...row.event, replyCount } });
+    }
+  }
+
   /** Include loaded echo wrappers and thread roots in the shared message read. */
   relatedMessageIds(messageEventId: string): string[] {
     const ids = new Set<string>();
diff --git a/packages/chatto-client/src/server/timelineSync.ts b/packages/chatto-client/src/server/timelineSync.ts
index 0bda9ecef..e8fa4fb33 100644
--- a/packages/chatto-client/src/server/timelineSync.ts
+++ b/packages/chatto-client/src/server/timelineSync.ts
@@ -160,6 +160,11 @@ export class TimelineSync {
     for (const store of this.#options.rooms.timelines(roomId || undefined)) {
       store.applyMessageRetraction(messageEventId, retractedAt);
     }
+    // The room timeline holds no thread replies, so a retracted reply never lowers
+    // its root's reply count. A deleted root would keep showing as a tombstone with
+    // replies; read the count of such roots again so an emptied thread disappears.
+    if (!roomId) return;
+    for (const store of this.#options.rooms.timelines(roomId)) store.refreshDeletedThreadRoots();
   }
 
