From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Phil Reif <pr@sambal.net>
Date: Thu, 22 Oct 2026 19:19:38 +0200
Subject: [PATCH] fix(frontend): show the featured call participant only once
 in the sidebar

The sidebar call layout shows the featured source above the participant list,
but the list kept the featured participant as a compact card. In the
two-column grid that card stretched to the height of the video card beside it
and looked like a second, empty tile. The featured card already has the name,
the audio controls and the menu, so the list now omits that participant.
---
 .../lib/components/voice/VoiceCallPanel.svelte    | 15 +++++++--------
 .../voice/VoiceCallPanel.svelte.spec.ts           | 12 ++++++++++++
 2 files changed, 19 insertions(+), 8 deletions(-)

diff --git a/apps/frontend/src/lib/components/voice/VoiceCallPanel.svelte b/apps/frontend/src/lib/components/voice/VoiceCallPanel.svelte
index 42ab4bce9..d2d74b129 100644
--- a/apps/frontend/src/lib/components/voice/VoiceCallPanel.svelte
+++ b/apps/frontend/src/lib/components/voice/VoiceCallPanel.svelte
@@ -1016,14 +1016,13 @@ Room sidebar panel for voice/video calls.
               {/if}
             {/each}
             {#each sortedParticipants as participant (participant.key)}
-              {@render participantCard(
-                participant,
-                isInThisCall &&
-                  hasVideo(participant) &&
-                  featuredStageTile?.key !== `${participant.key}:person`
-                  ? 'video'
-                  : 'compact'
-              )}
+              <!-- The featured card above already shows this participant. -->
+              {#if !isInThisCall || featuredStageTile?.key !== `${participant.key}:person`}
+                {@render participantCard(
+                  participant,
+                  isInThisCall && hasVideo(participant) ? 'video' : 'compact'
+                )}
+              {/if}
             {/each}
           </div>
         </section>
diff --git a/apps/frontend/src/lib/components/voice/VoiceCallPanel.svelte.spec.ts b/apps/frontend/src/lib/components/voice/VoiceCallPanel.svelte.spec.ts
index 127e2af82..6d88df18f 100644
--- a/apps/frontend/src/lib/components/voice/VoiceCallPanel.svelte.spec.ts
+++ b/apps/frontend/src/lib/components/voice/VoiceCallPanel.svelte.spec.ts
@@ -479,6 +479,18 @@ it('keeps voice cards equal in height with compact direct mute controls', async
   expect(muteSelf).toHaveBeenCalledTimes(2);
 });
 
+it('lists the featured participant only once in the sidebar', async () => {
+  const screen = renderCallPanelHarness({ layout: 'sidebar', scenario: 'camera' });
+  const featured = screen.getByTestId('call-sidebar-featured');
+  await expect.element(featured).toHaveTextContent('Alice');
+  const list = screen.container.querySelector<HTMLElement>(
+    '[data-testid="call-participants-list"]'
+  )!;
+  expect(list.textContent).not.toContain('Alice');
+  expect(list.textContent).toContain('Bob');
+  expect(list.textContent).toContain('Chloe');
+});
+
 it('keeps voice columns equal below a single screen share and stacks in a narrow pane', async () => {
   const screen = renderCallPanelHarness({ layout: 'sidebar', scenario: 'screen-voice' });
   screen.container.style.width = '500px';
-- 
