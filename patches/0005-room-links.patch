+  private getRoomPartialAtCursor(): { query: string; start: number } | null {
+    const editorApi = this.getEditorApi();
+    if (!editorApi || !this.getRoomLinkSource()) return null;
+    if (editorApi.isInCodeBlock()) return null;
+
+    const textBefore = editorApi.getTextBeforeCursor();
+    // `# ` at the start of a line is a heading, so the query needs a character.
+    const match = textBefore.match(/(?:^|\s)#([^\s#[\]()]+)$/u);
+    if (!match) return null;
+
+    return {
+      query: match[1],
+      start: textBefore.length - match[1].length - 1
+    };
