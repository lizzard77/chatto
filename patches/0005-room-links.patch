@@ -0,0 +1,61 @@
+<!--
+@component
+
+`#room` autocomplete popup.
+Shows matching rooms when typing #name in chat input. Selecting a room
+inserts a room link; see `$lib/roomLinks`.
+
+**Props:**
+- `query` - Current search query (without the leading #)
+- `rooms` - Rooms to search through
+- `onSelect` - Callback when a room is selected
+- `onClose` - Callback to close the popup
+-->
+<script lang="ts">
+  import AutocompletePopup from './AutocompletePopup.svelte';
+  import { rankRoomLinkCandidates, type RoomLinkRoom } from '$lib/roomLinks';
+  import { m } from '$lib/i18n/messages';
+
+  type Props = {
+    query: string;
+    rooms: RoomLinkRoom[];
+    onSelect: (room: RoomLinkRoom) => void;
+    onClose: () => void;
+  };
+
+  let { query, rooms, onSelect, onClose }: Props = $props();
+
+  let results = $derived(rankRoomLinkCandidates(query, rooms));
+
+  let popupRef = $state<{ handleKeyDown: (e: KeyboardEvent) => boolean } | null>(null);
+
+  export function handleKeyDown(event: KeyboardEvent): boolean {
+    return popupRef?.handleKeyDown(event) ?? false;
+  }
+</script>
+
+<AutocompletePopup
+  bind:this={popupRef}
+  items={results}
+  getKey={(room) => room.id}
+  selectKeys={['Enter', 'Tab']}
+  onSelect={(room) => onSelect(room)}
+  {onClose}
+  testid="room-autocomplete"
+  class="md:w-72"
+>
+  {#snippet item({ item: room })}
+    <div
+      class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-surface-emphasized text-sm font-semibold text-muted"
+      aria-hidden="true"
+    >
+      #
+    </div>
+    <bdi class="min-w-0 truncate text-sm text-text">{room.name}</bdi>
+    {#if !room.isMember}
+      <span class="min-w-0 truncate text-sm text-muted"
+        >{m('room_links.autocomplete_not_joined')}</span
+      >
+    {/if}
+  {/snippet}
+</AutocompletePopup>
