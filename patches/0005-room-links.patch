+/**
+ * Room links in message bodies.
+ *
+ * A room link is a plain Markdown link to a chat room route, such as
+ * `[#general](https://chat.example/chat/-/<roomId>)`. The composer inserts it
+ * with `#` autocomplete; clients without this feature still see a working
+ * link. After rendering, `resolveRenderedRoomLinks` turns the room links into
+ * room chips that show the current room name, or an "unknown room" chip when
+ * the viewer cannot see the room.
+ */
+
+import { RoomKind } from '@chatto/api-types/api/v1/rooms_pb';
+import type { RoomListItem, RoomListView } from '@chatto/client/server/rooms';
+import { resolveChatRoute } from '$lib/chatLinks';
+import { segmentToServerId } from '$lib/navigation';
+import { fuzzyMatch } from '$lib/fuzzyMatch';
+import { parseTrustedMarkdownHtml } from '$lib/security/trustedHtml';
+import { m } from '$lib/i18n/messages';
+
+/** A room that `#` autocomplete offers and room chips can name. */
+export type RoomLinkRoom = {
+  id: string;
+  name: string;
+  description?: string | null;
+  isMember: boolean;
+};
+
+/**
+ * Rooms of one server that room links can name, keyed by room ID. Contains
+ * every non-DM room that the viewer can see; a link to any other room shows as
+ * an unknown room.
+ */
+export type RoomLinkDirectory = {
+  serverId: string;
+  rooms: ReadonlyMap<string, RoomLinkRoom>;
+  /** DM rooms keep their link unchanged; they have no room name. */
+  directMessageIds: ReadonlySet<string>;
+};
+
+/** Builds the room link directory from the server's room list. */
+export function buildRoomLinkDirectory(
+  serverId: string,
+  rooms: readonly RoomListItem[]
+): RoomLinkDirectory {
+  const named = new Map<string, RoomLinkRoom>();
+  const directMessageIds = new Set<string>();
+  for (const room of rooms) {
+    if (room.type === RoomKind.DM) {
+      directMessageIds.add(room.id);
+      continue;
+    }
+    named.set(room.id, {
+      id: room.id,
+      name: room.name,
+      description: room.description,
+      isMember: room.viewerIsMember === true
+    });
+  }
+  return { serverId, rooms: named, directMessageIds };
+}
+
+/**
+ * Builds the room link directory from a server store's room list, or returns
+ * null while the list loads. Reactive when called in a reactive context.
+ * Test stores may have no room list.
+ */
+export function roomLinkDirectoryFor(
+  serverId: string,
+  roomList: RoomListView | undefined
+): RoomLinkDirectory | null {
+  if (!roomList || roomList.isLoading) return null;
+  return buildRoomLinkDirectory(serverId, roomList.rooms);
+}
+
+/** Absolute URL of a room on its server, as inserted by `#` autocomplete. */
+export { buildRoomLinkURL } from '$lib/chatLinks';
+
+const roomIdPattern = /^R[a-zA-Z0-9]{14}$|^[a-f0-9]{14}$/;
+
+/**
+ * Parses a link to a room route (not a thread or message) of a registered
+ * server, as an absolute URL or a local path.
+ */
+function parseRoomLink(href: string): { serverId: string; roomId: string } | null {
+  const path = resolveChatRoute(href);
+  if (!path) return null;
+  const parts = new URL(path, window.location.origin).pathname.split('/').filter(Boolean);
+  if (parts.length !== 3 || !roomIdPattern.test(parts[2])) return null;
+  const serverId = segmentToServerId(parts[1]);
+  return serverId ? { serverId, roomId: parts[2] } : null;
+}
+
+/**
+ * Returns whether a URL is a room link to the given server. The composer makes
+ * no link preview for such links: the room chip already shows the room.
+ */
+export function isRoomLinkOnServer(url: string, serverId: string): boolean {
+  return parseRoomLink(url)?.serverId === serverId;
+}
+
+/** Link label for a room, as inserted by `#` autocomplete. */
+export function roomLinkLabel(name: string): string {
+  return `#${name.replace(/[[\]\\]/g, '')}`;
+}
+
+/**
+ * Ranks rooms for `#` autocomplete: by match quality, then joined rooms first,
+ * then by name.
+ */
+export function rankRoomLinkCandidates(
+  query: string,
+  rooms: Iterable<RoomLinkRoom>,
+  limit = 10
+): RoomLinkRoom[] {
+  const scored: { room: RoomLinkRoom; score: number }[] = [];
+  for (const room of rooms) {
+    const score = query ? fuzzyMatch(query, room.name) : 1;
+    if (score === null || score <= 0) continue;
+    scored.push({ room, score });
+  }
+  scored.sort(
+    (a, b) =>
+      b.score - a.score ||
+      Number(b.room.isMember) - Number(a.room.isMember) ||
+      a.room.name.localeCompare(b.room.name)
+  );
+  return scored.slice(0, limit).map(({ room }) => room);
+}
+
+/** Whether the label of a room link is generated, so the chip may replace it. */
+function hasGeneratedLabel(anchor: Element, roomId: string): boolean {
+  const label = anchor.textContent?.trim() ?? '';
+  if (label.startsWith('#')) return true;
+  // A bare (linkified) room URL.
+  return parseRoomLink(label)?.roomId === roomId;
+}
+
+function unknownRoomChip(doc: Document): HTMLSpanElement {
+  const chip = doc.createElement('span');
+  chip.className = 'room-link room-link-unknown';
+  chip.setAttribute('title', m('room_links.unknown_title'));
+  const icon = doc.createElement('span');
+  icon.className = 'iconify icon-[uil--lock] room-link-icon';
+  icon.setAttribute('aria-hidden', 'true');
+  chip.append(icon, doc.createTextNode(m('room_links.unknown')));
+  return chip;
+}
+
+/**
+ * Turns the room links in HTML from `renderMarkdown` into room chips. A room
+ * link points to a room route, not to a thread or message.
+ *
+ * Links to rooms of `directory.serverId` that the viewer can see show the
+ * current room name when their label is generated (`#name` or a bare URL);
+ * custom labels stay. Links to rooms that the viewer cannot see become a
+ * non-clickable "unknown room" chip. Links to other servers and DMs stay
+ * unchanged. Without a directory (room list not loaded yet) nothing changes.
+ */
+export function resolveRenderedRoomLinks(
+  html: string,
+  directory: RoomLinkDirectory | null
+): string {
+  // Quick skip without DOM parsing when the HTML has no chat route link.
+  if (!directory || !html.includes('/chat/')) return html;
+
+  const doc = parseTrustedMarkdownHtml(html);
+  for (const anchor of doc.body.querySelectorAll('a[href]')) {
+    const href = anchor.getAttribute('data-content-href') ?? anchor.getAttribute('href') ?? '';
+    const link = parseRoomLink(href);
+    if (link?.serverId !== directory.serverId) continue;
+    const roomId = link.roomId;
+    if (directory.directMessageIds.has(roomId)) continue;
+
+    const room = directory.rooms.get(roomId);
+    if (!room) {
+      anchor.replaceWith(unknownRoomChip(doc));
+      continue;
+    }
+
+    anchor.classList.add('room-link');
+    if (hasGeneratedLabel(anchor, roomId)) {
+      anchor.textContent = roomLinkLabel(room.name);
+      anchor.setAttribute('dir', 'auto');
+    }
+  }
+
+  return doc.body.innerHTML;
+}
