+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { RoomKind } from '@chatto/api-types/api/v1/rooms_pb';
+import type { RoomListItem } from '@chatto/client/server/rooms';
+import { type RegisteredServer } from '@chatto/client/server/registry';
+import { serverRegistry } from '$lib/client';
+import { LinkPreviewState } from '$lib/components/composer/linkPreviews.svelte';
+import {
+  buildRoomLinkDirectory,
+  buildRoomLinkURL,
+  isRoomLinkOnServer,
+  rankRoomLinkCandidates,
+  resolveRenderedRoomLinks,
+  type RoomLinkRoom
+} from './roomLinks';
+
+const generalId = 'R123456789abcde';
+const secretId = 'Rsecret12345678';
+const dmId = 'abcdef12345678';
+
+const originServer: RegisteredServer = {
+  id: 'origin',
+  url: 'https://chat.example.test',
+  name: 'Origin',
+  iconUrl: null,
+  token: null,
+  userId: null,
+  userLogin: null,
+  userDisplayName: null,
+  userAvatarUrl: null,
+  reauthRequiredAt: null,
+  addedAt: 1
+};
+
+function room(id: string, name: string, type = RoomKind.CHANNEL, member = true): RoomListItem {
+  return {
+    id,
+    name,
+    type,
+    isUniversal: false,
+    viewerIsMember: member,
+    viewerCanJoinRoom: true,
+    viewerCanManageRoom: false,
+    members: []
+  };
+}
+
+const directory = buildRoomLinkDirectory('origin', [
+  room(generalId, 'general'),
+  room(dmId, '', RoomKind.DM)
+]);
+
+function roomURL(roomId: string): string {
+  return `${window.location.origin}/chat/-/${roomId}`;
+}
+
+function anchor(href: string, label: string): string {
+  return `<p><a href="${href}">${label}</a></p>`;
+}
+
+describe('room links', () => {
+  beforeEach(() => {
+    vi.spyOn(serverRegistry, 'originServer', 'get').mockReturnValue(originServer);
+    vi.spyOn(serverRegistry, 'isOriginServer').mockImplementation((id) => id === 'origin');
+    vi.spyOn(serverRegistry, 'getServer').mockImplementation((id) =>
+      id === 'origin' ? { ...originServer, url: window.location.origin } : undefined
+    );
+  });
+
+  afterEach(() => {
+    vi.restoreAllMocks();
+  });
+
+  it('builds an absolute room URL on the origin server', () => {
+    expect(buildRoomLinkURL('origin', generalId)).toBe(roomURL(generalId));
+  });
+
+  it('recognizes room links to the same server', () => {
+    expect(isRoomLinkOnServer(roomURL(generalId), 'origin')).toBe(true);
+    expect(isRoomLinkOnServer(roomURL(generalId), 'other')).toBe(false);
+    expect(isRoomLinkOnServer(`${roomURL(generalId)}/m/Eabc123DEF456gh`, 'origin')).toBe(false);
+    expect(isRoomLinkOnServer('https://example.com/chat/-/' + generalId, 'origin')).toBe(false);
+  });
+
+  it('makes no link preview for room links to the same server', async () => {
+    vi.useFakeTimers();
+    const fetchLinkPreview = vi.fn(async () => null);
+    const state = new LinkPreviewState(
+      () => ({ fetchLinkPreview }),
+      () => 'origin'
+    );
+    const cleanup = state.scheduleDetection(
+      `[#general](${roomURL(generalId)}) and https://example.com`,
+      false
+    );
+    await vi.advanceTimersByTimeAsync(500);
+    cleanup();
+    vi.useRealTimers();
+
+    expect(state.detectedURLs).toEqual(['https://example.com']);
+    expect(fetchLinkPreview).toHaveBeenCalledExactlyOnceWith('https://example.com');
+  });
+
+  it('shows the current room name for a generated label', () => {
+    const html = resolveRenderedRoomLinks(anchor(roomURL(generalId), '#old-name'), directory);
+    const link = new DOMParser().parseFromString(html, 'text/html').querySelector('a')!;
+    expect(link.classList.contains('room-link')).toBe(true);
+    expect(link.textContent).toBe('#general');
+  });
+
+  it('names a bare room URL', () => {
+    const html = resolveRenderedRoomLinks(
+      anchor(roomURL(generalId), roomURL(generalId)),
+      directory
+    );
+    expect(html).toContain('>#general</a>');
+  });
+
+  it('keeps a custom label', () => {
+    const html = resolveRenderedRoomLinks(anchor(roomURL(generalId), 'over here'), directory);
+    expect(html).toContain('class="room-link"');
+    expect(html).toContain('>over here</a>');
+  });
+
+  it('replaces a link to a room without access with an unknown room chip', () => {
+    const html = resolveRenderedRoomLinks(anchor(roomURL(secretId), '#secret'), directory);
+    const doc = new DOMParser().parseFromString(html, 'text/html');
+    expect(doc.querySelector('a')).toBeNull();
+    expect(doc.querySelector('.room-link-unknown')).not.toBeNull();
+    expect(html).not.toContain('secret');
+  });
+
+  it('reads the original URL of a rendered link', () => {
+    const html = resolveRenderedRoomLinks(
+      `<p><a href="/chat/-/${generalId}" data-content-href="${roomURL(generalId)}">#x</a></p>`,
+      directory
+    );
+    expect(html).toContain('>#general</a>');
+  });
+
+  it('keeps DM links, thread links and other links unchanged', () => {
+    const inputs = [
+      anchor(roomURL(dmId), 'dm'),
+      anchor(`${roomURL(generalId)}/Ethread12345678`, '#thread'),
+      anchor('https://example.com/chat/-/R123456789abcde', '#external')
+    ];
+    for (const input of inputs) {
+      expect(resolveRenderedRoomLinks(input, directory)).toBe(input);
+    }
+  });
+
+  it('changes nothing before the room list loads', () => {
+    const input = anchor(roomURL(secretId), '#secret');
+    expect(resolveRenderedRoomLinks(input, null)).toBe(input);
+  });
+
+  it('ranks rooms by match, then joined rooms first', () => {
+    const rooms: RoomLinkRoom[] = [
+      { id: 'a', name: 'random', isMember: true },
+      { id: 'b', name: 'dev-talk', isMember: false },
+      { id: 'c', name: 'dev', isMember: true },
+      { id: 'd', name: 'devops', isMember: true }
+    ];
+    expect(rankRoomLinkCandidates('dev', rooms).map((r) => r.name)).toEqual([
+      'dev',
+      'devops',
+      'dev-talk'
+    ]);
+  });
+});
