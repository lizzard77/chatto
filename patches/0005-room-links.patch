@@ -0,0 +1,99 @@
+import { describe, expect, it, vi } from 'vitest';
+
+import type { ComposerEditorApi } from './editorTypes';
+import { AutocompleteState, type RoomLinkSource } from './autocomplete.svelte';
+
+vi.mock('$lib/roomLinks', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('$lib/roomLinks')>()),
+  buildRoomLinkURL: (serverId: string, roomId: string) => `https://chat.test/${serverId}/${roomId}`
+}));
+
+const source: RoomLinkSource = {
+  serverId: 'origin',
+  rooms: [{ id: 'R123456789abcde', name: 'general', isMember: true }]
+};
+
+function editor(initialText: string, { withLinks = false, inCode = false } = {}) {
+  let text = initialText;
+  const links: { label: string; href: string }[] = [];
+  const api: ComposerEditorApi = {
+    getText: () => text,
+    setContent: (next) => {
+      text = next;
+    },
+    focus: () => {},
+    performEnter: () => {},
+    getTextBeforeCursor: () => text,
+    isInCodeBlock: () => inCode,
+    replaceTextBeforeCursor: (charCount, replacement) => {
+      text = text.slice(0, text.length - charCount) + replacement;
+    },
+    insertText: (inserted) => {
+      text += inserted;
+    },
+    toggleFormatting: () => {},
+    adjustIndent: () => false,
+    insertQuote: () => {}
+  };
+  if (withLinks) {
+    api.replaceTextBeforeCursorWithLink = (charCount, label, href) => {
+      text = text.slice(0, text.length - charCount) + label + ' ';
+      links.push({ label, href });
+    };
+  }
+  return { api, links, getText: () => text };
+}
+
+function autocomplete(api: ComposerEditorApi, roomSource: RoomLinkSource | null = source) {
+  return new AutocompleteState(
+    () => api,
+    () => [],
