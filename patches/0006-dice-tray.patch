--- /dev/null
+++ b/apps/frontend/src/lib/components/composer/ComposerDiceTray.svelte
@@ -0,0 +1,185 @@
+<!--
+@component
+
+Composer button that opens the dice tray: pick dice and a modifier, then post
+the roll as a `!r` command for the dice bot. See `$lib/diceTray/diceTray.svelte`.
+-->
+<script lang="ts">
+  import { page } from '$app/state';
+  import { CompactActionButton, ContextMenu } from '$lib/ui';
+  import { Button } from '$lib/ui/form';
+  import { m } from '$lib/i18n/messages';
+  import { toastError } from '$lib/utils/errorMessage';
+  import { useServerScope } from '$lib/state/server/scope.svelte';
+  import { createMessageAPI } from '@chatto/client/api/messages';
+  import {
+    DICE_SIDES,
+    MAX_DICE_PER_SIZE,
+    diceTray,
+    dualityCommand,
+    rollCommand,
+    type DicePool,
+    type DieSides
+  } from '$lib/diceTray/diceTray.svelte';
+
+  let { disabled }: { disabled: boolean } = $props();
+
+  const serverScope = useServerScope();
+  const tray = diceTray(serverScope.serverId);
+  const roomId = $derived(page.params.roomId ?? null);
+
+  let triggerElement = $state<HTMLButtonElement>();
+  let open = $state(false);
+  let anchor = $state<{ top: number; bottom: number; left: number } | null>(null);
+  let sending = $state(false);
+  // The pool stays after a roll, so the same roll can be repeated.
+  let pool = $state<DicePool>({});
+  let modifier = $state(0);
+  const command = $derived(rollCommand(pool, modifier));
+
+  function openTray(event: MouseEvent): void {
+    if (disabled || !roomId) return;
+    const button = event.currentTarget as HTMLButtonElement;
+    const rect = button.getBoundingClientRect();
+    triggerElement = button;
+    anchor = { top: rect.top, bottom: rect.bottom, left: rect.left };
+    open = true;
+  }
+
+  function closeTray({ restoreFocus = true }: { restoreFocus?: boolean } = {}): void {
+    open = false;
+    anchor = null;
+    if (restoreFocus) triggerElement?.focus();
+  }
+
+  function addDie(sides: DieSides): void {
+    pool = { ...pool, [sides]: Math.min((pool[sides] ?? 0) + 1, MAX_DICE_PER_SIZE) };
+  }
+
+  function removeDie(event: MouseEvent, sides: DieSides): void {
+    event.preventDefault();
+    pool = { ...pool, [sides]: Math.max((pool[sides] ?? 0) - 1, 0) };
+  }
+
+  function clear(): void {
+    pool = {};
+    modifier = 0;
+  }
+
+  async function send(body: string | null): Promise<void> {
+    if (!body || !roomId || sending) return;
+    sending = true;
+    try {
+      await serverScope.connection.getAPI(createMessageAPI).createMessage({
+        roomId,
+        body,
+        // The bot moves results into the collection thread anyway; posting there
+        // keeps the command out of the room timeline until the bot removes it.
+        threadRootEventId: tray.diceThread(roomId)
+      });
+      closeTray({ restoreFocus: false });
+    } catch (error) {
+      toastError(error, m('composer.dice_tray.failed'));
+    } finally {
+      sending = false;
+    }
+  }
+</script>
+
+<CompactActionButton
+  wrapperClass="mobile-presentation:pill-button-group-touch"
+  label={m('composer.dice_tray.open')}
+  type="button"
+  onpointerdown={(event) => event.preventDefault()}
+  onclick={openTray}
+  disabled={disabled || !roomId}
+  title={m('composer.dice_tray.open')}
+>
+  <span aria-hidden="true" class="iconify icon-[uil--dice-five] text-[15px]"></span>
+</CompactActionButton>
+
+{#if open}
+  <ContextMenu
+    {anchor}
+    role="dialog"
+    ariaLabel={m('composer.dice_tray.title')}
+    class="w-[min(20rem,calc(100vw-1rem))]"
+    onclose={closeTray}
+  >
+    <div class="flex flex-col gap-1" data-testid="dice-tray">
+      <header class="flex items-center gap-2 menu-section px-3 py-2 text-sm font-medium">
+        <span aria-hidden="true" class="iconify icon-[uil--dice-five] text-muted"></span>
+        <span class="flex-1">{m('composer.dice_tray.title')}</span>
+        <span class="text-muted tabular-nums" aria-live="polite">
+          {command ? command.slice(3) : m('composer.dice_tray.empty')}
+        </span>
+      </header>
+
+      <section class="flex flex-col gap-3 menu-section px-3 py-2">
+        <div class="grid grid-cols-4 gap-1.5">
+          {#each DICE_SIDES as sides (sides)}
+            {@const count = pool[sides] ?? 0}
+            <button
+              type="button"
+              class={[
+                'relative cursor-pointer rounded-md border border-border px-1 py-2 text-sm font-medium hover:bg-surface-emphasized',
+                count > 0 && 'bg-surface-selected'
+              ]}
+              aria-label={m('composer.dice_tray.add_die', {
+                die: m('composer.dice_tray.die', { sides })
+              })}
+              onclick={() => addDie(sides)}
+              oncontextmenu={(event) => removeDie(event, sides)}
+            >
+              {m('composer.dice_tray.die', { sides })}
+              {#if count > 0}
+                <span
+                  class="absolute -end-1 -top-1 min-w-4 rounded-full bg-action px-1 text-xs text-on-action"
+                  aria-hidden="true">{count}</span
+                >
+              {/if}
+            </button>
+          {/each}
+          <Button size="sm" variant="ghost" onclick={clear}>
+            {m('composer.dice_tray.clear')}
+          </Button>
+        </div>
+
+        <div class="flex items-center gap-2 text-sm">
+          <span class="flex-1 text-muted">{m('composer.dice_tray.modifier')}</span>
+          <button
+            type="button"
+            class="w-8 cursor-pointer rounded-md border border-border py-1 hover:bg-surface-emphasized"
+            aria-label={m('composer.dice_tray.decrease')}
+            onclick={() => (modifier -= 1)}>−</button
+          >
+          <span class="w-8 text-center tabular-nums"
+            >{modifier > 0 ? `+${modifier}` : modifier}</span
+          >
+          <button
+            type="button"
+            class="w-8 cursor-pointer rounded-md border border-border py-1 hover:bg-surface-emphasized"
+            aria-label={m('composer.dice_tray.increase')}
+            onclick={() => (modifier += 1)}>+</button
+          >
+        </div>
+        <p class="text-xs text-muted">{m('composer.dice_tray.hint')}</p>
+      </section>
+
+      <footer class="flex justify-end gap-2 menu-section px-3 py-2">
+        <Button
+          size="sm"
+          variant="secondary"
+          disabled={sending}
+          title={m('composer.dice_tray.duality_hint')}
+          onclick={() => send(dualityCommand(modifier))}
+        >
+          {m('composer.dice_tray.duality')}
+        </Button>
+        <Button size="sm" disabled={!command || sending} onclick={() => send(command)}>
+          {m('composer.dice_tray.roll')}
+        </Button>
+      </footer>
+    </div>
+  </ContextMenu>
+{/if}
