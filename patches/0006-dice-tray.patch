diff --git a/apps/frontend/src/lib/diceTray/DiceTrayResults.svelte b/apps/frontend/src/lib/diceTray/DiceTrayResults.svelte
new file mode 100644
index 000000000..aaa959863
--- /dev/null
+++ b/apps/frontend/src/lib/diceTray/DiceTrayResults.svelte
@@ -0,0 +1,97 @@
+<!--
+@component
+
+Small card above the room composer with the latest dice bot results of the
+room: the latest roll for players, the latest roll per player for a GM. It
+follows live events, thread replies included, and loads the newest results of
+the known collection thread once. See `$lib/diceTray/diceTray.svelte`.
+-->
+<script lang="ts">
+  import { onMount } from 'svelte';
+  import { m } from '$lib/i18n/messages';
+  import { useProjectionEvent } from '$lib/hooks';
+  import { useServerScope } from '$lib/state/server/scope.svelte';
+  import { createRoomTimelineAPI } from '@chatto/client/api/roomTimeline';
+  import { unmask } from '@chatto/client/room/messages/helpers';
+  import { isMessagePostedEvent } from '@chatto/client/timeline/timelineEvents';
+  import { diceTray, parseTrayRoll } from './diceTray.svelte';
+
+  let { roomId }: { roomId: string } = $props();
+
+  const serverScope = useServerScope();
+  const stores = serverScope.store;
+  const tray = diceTray(serverScope.serverId);
+  const rolls = $derived(tray.rolls(roomId));
+  const gm = $derived(tray.viewerIsGm);
+  const shown = $derived(gm ? rolls.latestPerRoller : rolls.latest ? [rolls.latest] : []);
+  // Hidden until a newer roll arrives.
+  let hiddenUntilAfter = $state<string | null>(null);
+  const visible = $derived(shown.length > 0 && shown[0].eventId !== hiddenUntilAfter);
+
+  useProjectionEvent((update) => {
+    const event = update.event;
+    const semantic = event?.event;
+    if (!event || semantic?.case !== 'messagePosted') return;
+    const posted = semantic.value;
+    if (posted.roomId !== roomId || posted.echoOfEventId) return;
+    const body = posted.bodyPlaintext;
+    if (!body?.includes('#chatto-dice:')) return;
+    const roll = parseTrayRoll(event.id, body, event.createdAt?.toDate().getTime() ?? Date.now());
+    if (!roll) return;
+    tray.ingest(roomId, roll, posted.threadRootEventId || null, stores.accountId, { live: true });
+  });
+
+  onMount(() => {
+    const threadRootEventId = tray.diceThread(roomId);
+    if (!threadRootEventId) return;
+    let cancelled = false;
+    serverScope.connection
+      .getAPI(createRoomTimelineAPI)
+      .getThreadEvents({ roomId, threadRootEventId, limit: 50 })
+      .then((page) => {
+        if (cancelled) return;
+        for (const view of unmask(page.events)) {
+          const payload = view.event;
+          if (!isMessagePostedEvent(payload) || !payload.body) continue;
+          const roll = parseTrayRoll(view.id, payload.body, Date.parse(view.createdAt));
+          if (roll) tray.ingest(roomId, roll, threadRootEventId, stores.accountId, { live: false });
+        }
+      })
+      // Older results are a convenience; live rolls still arrive.
+      .catch(() => {});
+    return () => (cancelled = true);
+  });
+</script>
+
+{#if visible}
+  <div
+    class="mx-2 mb-1 rounded-lg border border-border bg-surface px-3 py-1.5 text-sm desktop-presentation:mx-4"
+    data-testid="dice-tray-results"
+    aria-live="polite"
+  >
+    <div class="flex items-center gap-2">
+      <span aria-hidden="true" class="iconify icon-[uil--dice-five] shrink-0 text-muted"></span>
+      {#if gm}
+        <span class="min-w-0 flex-1 font-medium">{m('composer.dice_tray.per_player')}</span>
+      {:else}
+        <span class="min-w-0 flex-1 truncate" title={shown[0].text}>{shown[0].text}</span>
+      {/if}
+      <button
+        type="button"
+        class="flex shrink-0 cursor-pointer items-center text-muted hover:text-text"
+        aria-label={m('composer.dice_tray.hide')}
+        title={m('composer.dice_tray.hide')}
+        onclick={() => (hiddenUntilAfter = shown[0].eventId)}
+      >
+        <span aria-hidden="true" class="iconify icon-[uil--times]"></span>
+      </button>
+    </div>
+    {#if gm}
+      <ul class="mt-1 flex flex-col gap-0.5 ps-6">
+        {#each shown as roll (roll.rollerId)}
+          <li class="truncate" title={roll.text}>{roll.text}</li>
+        {/each}
+      </ul>
+    {/if}
+  </div>
+{/if}
