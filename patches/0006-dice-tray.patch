@@ -0,0 +1,63 @@
+import { describe, expect, it } from 'vitest';
+import { ServerDiceTray, dualityCommand, parseTrayRoll, rollCommand } from './diceTray.svelte';
+
+describe('rollCommand', () => {
+  it('builds the bot command from the pool in die order with the modifier', () => {
+    expect(rollCommand({ 20: 1, 6: 2 }, 3)).toBe('!r 2d6+d20+3');
+    expect(rollCommand({ 100: 1 }, -2)).toBe('!r d100-2');
+  });
+
+  it('returns null without dice', () => {
+    expect(rollCommand({}, 2)).toBeNull();
+    expect(rollCommand({ 6: 0 }, 0)).toBeNull();
+  });
+});
+
+describe('dualityCommand', () => {
+  it('lets the bot pick the duality dice', () => {
+    expect(dualityCommand(0)).toBe('!r');
+    expect(dualityCommand(2)).toBe('!r +2');
+    expect(dualityCommand(-1)).toBe('!r -1');
+  });
+});
+
+describe('parseTrayRoll', () => {
+  it('reads roller, GM flag, and a plain result text', () => {
+    const roll = parseTrayRoll(
+      'e1',
+      '**Phil** 🎲 **12** — 3d6+4: [2, 5, 1]+4 = 12 [🎲](#chatto-dice:std.6.2,std.6.5,std.6.1;by=u_phil;gm=1)',
+      1000
+    );
+    expect(roll).toEqual({
+      eventId: 'e1',
+      rollerId: 'u_phil',
+      gm: true,
+      text: 'Phil 🎲 12 — 3d6+4: [2, 5, 1]+4 = 12',
+      createdAtMs: 1000
+    });
+  });
+
+  it('ignores bodies without a marker or without a roller', () => {
+    expect(parseTrayRoll('e1', 'Hello', 0)).toBeNull();
+    expect(parseTrayRoll('e1', 'x [🎲](#chatto-dice:std.6.2)', 0)).toBeNull();
+  });
+});
+
+describe('ServerDiceTray', () => {
+  const roll = (eventId: string, rollerId: string, at: number, gm = false) =>
+    parseTrayRoll(eventId, `x [🎲](#chatto-dice:std.6.2;by=${rollerId}${gm ? ';gm=1' : ''})`, at)!;
+
+  it('keeps the latest roll per roller and learns GM mode from own rolls', () => {
+    localStorage.clear();
+    const tray = new ServerDiceTray('srv');
+    tray.ingest('r', roll('a', 'u_bob', 1), 't1', 'u_gm', { live: true });
+    tray.ingest('r', roll('b', 'u_gm', 2, true), 't1', 'u_gm', { live: true });
+    tray.ingest('r', roll('c', 'u_bob', 3), 't1', 'u_gm', { live: true });
+
+    expect(tray.rolls('r').latest?.eventId).toBe('c');
+    expect(tray.rolls('r').latestPerRoller.map((r) => r.eventId)).toEqual(['c', 'b']);
+    expect(tray.viewerIsGm).toBe(true);
+    expect(tray.diceThread('r')).toBe('t1');
+    expect(new ServerDiceTray('srv').diceThread('r')).toBe('t1');
+  });
+});
diff --git a/apps/frontend/src/lib/diceTray/diceTray.svelte.ts b/apps/frontend/src/lib/diceTray/diceTray.svelte.ts
new file mode 100644
index 000000000..ccab68c4d
--- /dev/null
+++ b/apps/frontend/src/lib/diceTray/diceTray.svelte.ts
@@ -0,0 +1,166 @@
+/**
+ * Dice tray: roll dice from the composer and show the latest dice bot results.
+ *
+ * The tray does not roll. It posts a `!r <notation>` command for a dice bot,
+ * for example Pantheon, and reads the bot's replies. A reply carries a marker
+ * link `[🎲](#chatto-dice:<dice>;by=<userId>;gm=1)`; `by` names who rolled and
+ * `gm=1` marks a roll in the bot's GM mode. The bot posts the replies into a
+ * per-session collection thread of the room, which `!dice` in a thread sets up.
+ *
+ * Players see the latest roll of the room. A viewer whose own latest roll was a
+ * GM roll sees the latest roll per player instead. All state is device-local.
+ */
+
+import { Codecs, serverSlot, type StorageSlot } from '@chatto/client/storage/slot';
+
+/** Die sizes that the tray offers. */
+export const DICE_SIDES = [4, 6, 8, 10, 12, 20, 100] as const;
+export type DieSides = (typeof DICE_SIDES)[number];
+
+/** How many dice of each size the viewer picked. */
+export type DicePool = Partial<Record<DieSides, number>>;
+
+/** At most this many dice of one size, like the bot's own limit. */
+export const MAX_DICE_PER_SIZE = 10;
+
+const signed = (value: number) => (value > 0 ? `+${value}` : value < 0 ? `${value}` : '');
+
+/** The bot command for a pool and a modifier, for example `!r 2d6+d20+1`; null without dice. */
+export function rollCommand(pool: DicePool, modifier: number): string | null {
+  const terms = DICE_SIDES.flatMap((sides) => {
+    const count = pool[sides] ?? 0;
+    return count > 0 ? [`${count > 1 ? count : ''}d${sides}`] : [];
+  });
+  return terms.length > 0 ? `!r ${terms.join('+')}${signed(modifier)}` : null;
+}
+
+/** The Daggerheart duality roll: the bot rolls Hope and Fear (or the GM's die). */
+export function dualityCommand(modifier: number): string {
+  return modifier ? `!r ${signed(modifier)}` : '!r';
+}
+
+/** One dice bot result. */
+export type TrayRoll = {
+  eventId: string;
+  rollerId: string;
+  gm: boolean;
+  /** Readable result without markup, for example `Phil 🎲 12 — 3d6+4: [2, 5, 1]+4 = 12`. */
+  text: string;
+  createdAtMs: number;
+};
+
+const MARKER = /\s*\[🎲\]\(#chatto-dice:([^)\s]{1,700})\)/g;
+
+/** Strip Markdown emphasis and escapes so the result fits in one line of plain text. */
+function plainText(markdown: string): string {
+  return markdown
+    .replace(MARKER, '')
+    .replace(/(\*\*|__|~~|`)/g, '')
+    .replace(/\\([\\`*_~[\]()#>|@])/g, '$1')
+    .replace(/\s+/g, ' ')
+    .trim();
+}
+
+/** A dice bot result from a message body, or null when the body has no marker with `by`. */
+export function parseTrayRoll(eventId: string, body: string, createdAtMs: number): TrayRoll | null {
+  const payload = [...body.matchAll(MARKER)][0]?.[1];
+  if (!payload) return null;
+  const params: Record<string, string> = Object.fromEntries(
+    payload
+      .split(';')
+      .slice(1)
+      .map((param) => param.split('='))
+  );
+  const rollerId = params.by;
+  if (!rollerId) return null;
+  return { eventId, rollerId, gm: params.gm === '1', text: plainText(body), createdAtMs };
+}
+
+const MAX_ROLLS = 200;
+
+/** Results of one room, oldest first. */
+class RoomDiceRolls {
+  rolls = $state<TrayRoll[]>([]);
+
+  add(roll: TrayRoll): void {
+    if (this.rolls.some((existing) => existing.eventId === roll.eventId)) return;
+    const next = [...this.rolls, roll].sort((a, b) => a.createdAtMs - b.createdAtMs);
+    this.rolls = next.slice(-MAX_ROLLS);
+  }
+
+  get latest(): TrayRoll | null {
+    return this.rolls.at(-1) ?? null;
+  }
+
+  /** The latest roll of each roller, newest first. */
+  get latestPerRoller(): TrayRoll[] {
+    const byRoller: Record<string, TrayRoll> = {};
+    for (const roll of this.rolls) byRoller[roll.rollerId] = roll;
+    return Object.values(byRoller).sort((a, b) => b.createdAtMs - a.createdAtMs);
+  }
+}
+
+const threadsCodec = Codecs.json<Record<string, string>>(
+  (value): value is Record<string, string> =>
+    typeof value === 'object' &&
+    value !== null &&
+    Object.values(value).every((thread) => typeof thread === 'string')
+);
+
+/** Dice tray state of one server. */
+export class ServerDiceTray {
+  readonly #threads: StorageSlot<Record<string, string>>;
+  readonly #gm: StorageSlot<boolean>;
+  // Each RoomDiceRolls is reactive itself; this only hands out one per room.
+  readonly #rooms: Record<string, RoomDiceRolls> = {};
+  #threadIds = $state<Record<string, string>>({});
+  /** The viewer's own latest roll was a GM roll. */
+  viewerIsGm = $state(false);
+
+  constructor(serverId: string) {
+    this.#threads = serverSlot(serverId, 'dice-tray-threads', {}, threadsCodec);
+    this.#gm = serverSlot(serverId, 'dice-tray-gm', false, Codecs.boolean);
+    this.#threadIds = this.#threads.get();
+    this.viewerIsGm = this.#gm.get();
+  }
+
+  /** The collection thread that the bot last posted a roll into, if known. */
+  diceThread(roomId: string): string | null {
+    return this.#threadIds[roomId] ?? null;
+  }
+
+  rolls(roomId: string): RoomDiceRolls {
+    return (this.#rooms[roomId] ??= new RoomDiceRolls());
+  }
+
+  /** Record a result; `threadRootEventId` is the thread the bot posted it into. */
+  ingest(
+    roomId: string,
+    roll: TrayRoll,
+    threadRootEventId: string | null,
+    viewerId: string | null,
+    { live }: { live: boolean }
+  ): void {
+    this.rolls(roomId).add(roll);
+    if (live && threadRootEventId && this.#threadIds[roomId] !== threadRootEventId) {
+      this.#threadIds = { ...this.#threadIds, [roomId]: threadRootEventId };
+      this.#threads.set(this.#threadIds);
+    }
+    const own = viewerId !== null && roll.rollerId === viewerId;
+    // Only the viewer's newest own roll decides, also when older rolls load later.
+    const ownLatest = own
+      ? this.rolls(roomId).latestPerRoller.find((r) => r.rollerId === viewerId)
+      : undefined;
+    if (ownLatest?.eventId === roll.eventId) {
+      this.viewerIsGm = roll.gm;
+      this.#gm.set(roll.gm);
+    }
+  }
+}
+
+const trays: Record<string, ServerDiceTray> = {};
+
+/** The dice tray state of a server, shared by its composers and panes. */
+export function diceTray(serverId: string): ServerDiceTray {
+  return (trays[serverId] ??= new ServerDiceTray(serverId));
+}
