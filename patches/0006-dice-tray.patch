diff --git a/apps/frontend/src/lib/diceTray/diceTray.svelte.spec.ts b/apps/frontend/src/lib/diceTray/diceTray.svelte.spec.ts
new file mode 100644
index 000000000..99c9d7e25
--- /dev/null
+++ b/apps/frontend/src/lib/diceTray/diceTray.svelte.spec.ts
@@ -0,0 +1,225 @@
+import { describe, expect, it } from 'vitest';
+import {
+  ServerDiceTray,
+  applyDiceAction,
+  emptyRoll,
+  isEmptyRoll,
+  formatRollCommand,
+  parseDiceSystem,
+  parseRollCommand,
+  parseTrayRoll
+} from './diceTray.svelte';
+
+describe('parseRollCommand', () => {
+  it('reads dice, modifier and the Wild Die choice of a typed roll', () => {
+    expect(parseRollCommand('!r 2d6+d20+3')).toEqual({
+      pool: { 6: 2, 20: 1 },
+      modifier: 3,
+      wild: null,
+      advantage: 'normal',
+      damage: false
+    });
+    expect(parseRollCommand('!roll wild W8 - 1')).toEqual({
+      pool: { 8: 1 },
+      modifier: -1,
+      wild: true,
+      advantage: 'normal',
+      damage: false
+    });
+    expect(parseRollCommand('!R extra d6')).toEqual({
+      pool: { 6: 1 },
+      modifier: 0,
+      wild: false,
+      advantage: 'normal',
+      damage: false
+    });
+    expect(parseRollCommand('!r')).toEqual({
+      pool: {},
+      modifier: 0,
+      wild: null,
+      advantage: 'normal',
+      damage: false
+    });
+    expect(parseRollCommand('!r adv +2')).toEqual({
+      pool: {},
+      modifier: 2,
+      wild: null,
+      advantage: 'adv',
+      damage: false
+    });
+    expect(parseRollCommand('!r -1 disadvantage')?.advantage).toBe('dis');
+  });
+
+  it('leaves other text and rolls that the bar cannot extend', () => {
+    for (const text of [
+      'hallo',
+      '!rx',
+      '!ini Mira',
+      '!r fireball',
+      '!r 4d6kh3',
+      '!r d7',
+      '!r 11d6',
+      '!r d6x'
+    ]) {
+      expect(parseRollCommand(text)).toBeNull();
+    }
+  });
+});
+
+describe('formatRollCommand', () => {
+  it('writes dice in die order, the modifier, the Wild Die choice and advantage', () => {
+    const roll = emptyRoll();
+    expect(formatRollCommand({ ...roll, pool: { 20: 1, 6: 2 }, modifier: 3 })).toBe('!r 2d6+d20+3');
+    expect(formatRollCommand({ ...roll, pool: { 8: 1 }, wild: false })).toBe('!r extra d8');
+    expect(formatRollCommand({ ...roll, pool: { 12: 2 }, modifier: 2, advantage: 'adv' })).toBe(
+      '!r 2d12+2 adv'
+    );
+    expect(formatRollCommand({ ...roll, modifier: -1 })).toBe('!r -1');
+    expect(formatRollCommand(roll)).toBe('!r');
+    expect(formatRollCommand({ ...roll, pool: { 6: 2, 8: 1 }, damage: true, wild: true })).toBe(
+      '!r dmg 2d6+d8'
+    );
+    expect(parseRollCommand('!r dmg 2d6+1')).toMatchObject({ pool: { 6: 2 }, damage: true });
+  });
+});
+
+describe('applyDiceAction', () => {
+  it('adds dice and modifiers and toggles advantage', () => {
+    let roll = emptyRoll();
+    expect(isEmptyRoll(roll)).toBe(true);
+    roll = applyDiceAction(roll, { die: 12 });
+    roll = applyDiceAction(roll, { die: 12 });
+    roll = applyDiceAction(roll, { modifier: 1 });
+    roll = applyDiceAction(roll, { advantage: 'adv' });
+    expect(formatRollCommand(roll)).toBe('!r 2d12+1 adv');
+    roll = applyDiceAction(roll, { advantage: 'adv' });
+    expect(formatRollCommand(roll)).toBe('!r 2d12+1');
+    roll = applyDiceAction(roll, { advantage: 'dis' });
+    expect(formatRollCommand(roll)).toBe('!r 2d12+1 dis');
+    expect(isEmptyRoll(roll)).toBe(false);
+  });
+});
+
+describe('parseTrayRoll', () => {
+  it('reads roller, GM flag, and a plain result text', () => {
+    const roll = parseTrayRoll(
+      'e1',
+      '**Phil** 🎲 **12** — 3d6+4: [2, 5, 1]+4 = 12 [🎲](#chatto-dice:std.6.2,std.6.5,std.6.1;by=u_phil;gm=1)',
+      1000
+    );
+    expect(roll).toEqual({
+      eventId: 'e1',
+      rollerId: 'u_phil',
+      gm: true,
+      text: 'Phil 🎲 12 — 3d6+4: [2, 5, 1]+4 = 12',
+      createdAtMs: 1000,
+      note: false,
+      dice: [
+        { kind: 'std', sides: 6, value: 2 },
+        { kind: 'std', sides: 6, value: 5 },
+        { kind: 'std', sides: 6, value: 1 }
+      ],
+      total: 12,
+      summary: '🎲 12 — 3d6+4: [2, 5, 1]+4 = 12',
+      swade: null
+    });
+  });
+
+  it('reads an error note that only names the roller', () => {
+    const roll = parseTrayRoll(
+      'e2',
+      '**Phil** ❌ Zu viele Würfel: höchstens 999 auf einmal [\u200b](#chatto-dice-note:by=u_phil)',
+      2000
+    );
+    expect(roll).toMatchObject({
+      rollerId: 'u_phil',
+      note: true,
+      text: 'Phil ❌ Zu viele Würfel: höchstens 999 auf einmal',
+      dice: [],
+      total: null,
+      summary: '❌ Zu viele Würfel: höchstens 999 auf einmal'
+    });
+  });
+
+  it('ignores bodies without a marker or without a roller', () => {
+    expect(parseTrayRoll('e1', 'Hello', 0)).toBeNull();
+    expect(parseTrayRoll('e1', 'x [🎲](#chatto-dice:std.6.2)', 0)).toBeNull();
+  });
+});
+
+describe('ServerDiceTray', () => {
+  const roll = (eventId: string, rollerId: string, at: number, gm = false) =>
+    parseTrayRoll(eventId, `x [🎲](#chatto-dice:std.6.2;by=${rollerId}${gm ? ';gm=1' : ''})`, at)!;
+
+  it('keeps the latest roll per roller and learns GM mode from own rolls', () => {
+    localStorage.clear();
+    const tray = new ServerDiceTray('srv');
+    tray.ingest('r', roll('a', 'u_bob', 1), 't1', 'u_gm', { live: true });
+    tray.ingest('r', roll('b', 'u_gm', 2, true), 't1', 'u_gm', { live: true });
+    tray.ingest('r', roll('c', 'u_bob', 3), 't1', 'u_gm', { live: true });
+
+    expect(tray.rolls('r').latest?.eventId).toBe('c');
+    expect(tray.rolls('r').latestPerRoller.map((r) => r.eventId)).toEqual(['c', 'b']);
+    expect(tray.viewerIsGm).toBe(true);
+    expect(tray.diceThread('r')).toBe('t1');
+    expect(new ServerDiceTray('srv').diceThread('r')).toBe('t1');
+  });
+
+  it('keeps notes out of the latest rolls and shows them to their roller only', () => {
+    localStorage.clear();
+    const tray = new ServerDiceTray('srv2');
+    const note = parseTrayRoll('n', 'x ❌ [\u200b](#chatto-dice-note:by=u_bob)', 5)!;
+    tray.ingest('r', roll('a', 'u_alice', 1), 't', 'u_bob', { live: true });
+    tray.ingest('r', note, 't', 'u_bob', { live: true });
+
+    expect(tray.rolls('r').latest?.eventId).toBe('a');
+    expect(tray.rolls('r').latestPerRoller.map((r) => r.eventId)).toEqual(['a']);
+    expect(tray.rolls('r').latestNote('u_bob')?.eventId).toBe('n');
+    expect(tray.rolls('r').latestNote('u_alice')).toBeNull();
+  });
+});
+
+describe('parseDiceSystem', () => {
+  it('reads the system from dice markers, notes, and system markers', () => {
+    expect(parseDiceSystem('🎲 7 [🎲](#chatto-dice:std.6.4,std.6.3;by=u1;sys=swade)')).toBe(
+      'swade'
+    );
+    expect(parseDiceSystem('❌ nope [\u200b](#chatto-dice-note:by=u1;sys=raw)')).toBe('raw');
+    expect(parseDiceSystem('System: Daggerheart [\u200b](#chatto-dice-system:dh)')).toBe('dh');
+  });
+
+  it('ignores markers without a known system', () => {
+    expect(parseDiceSystem('[🎲](#chatto-dice:std.6.4;by=u1)')).toBeNull();
+    expect(parseDiceSystem('[\u200b](#chatto-dice-system:chess)')).toBeNull();
+  });
+});
+
+describe('ServerDiceTray.system', () => {
+  it('defaults to Daggerheart and keeps the newest reported system', () => {
+    const tray = new ServerDiceTray('server-system-test');
+    expect(tray.system('r1')).toBe('dh');
+    tray.noteSystem('r1', 'swade', 2000);
+    tray.noteSystem('r1', 'dh', 1000); // an older message loaded later
+    expect(tray.system('r1')).toBe('swade');
+    tray.noteSystem('r1', 'raw', 3000);
+    expect(tray.system('r1')).toBe('raw');
+  });
+});
+
+describe('ServerDiceTray.noteRollSent', () => {
+  it('remembers sent roll commands until the viewer starts a new roll', () => {
+    const tray = new ServerDiceTray('server-sent');
+    tray.noteRollSent('room', 'Hallo zusammen', 'u1');
+    expect(tray.sentRoll('room')).toBeNull();
+    tray.noteRollSent('room', '!r 2d12+1 adv', 'u1');
+    expect(tray.sentRoll('room')).toMatchObject({
+      command: '!r 2d12+1 adv',
+      roll: { pool: { 12: 2 }, modifier: 1, advantage: 'adv' },
+      before: null
+    });
+    tray.noteRollSent('room', '!roll fireball', 'u1');
+    expect(tray.sentRoll('room')).toMatchObject({ command: '!roll fireball', roll: null });
+    tray.clearSentRoll('room');
+    expect(tray.sentRoll('room')).toBeNull();
+  });
+});
diff --git a/apps/frontend/src/lib/diceTray/diceTray.svelte.ts b/apps/frontend/src/lib/diceTray/diceTray.svelte.ts
