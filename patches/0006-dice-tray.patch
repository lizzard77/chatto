diff --git a/apps/frontend/src/lib/diceTray/DiceBar.svelte b/apps/frontend/src/lib/diceTray/DiceBar.svelte
new file mode 100644
index 000000000..2b8f52a7c
--- /dev/null
+++ b/apps/frontend/src/lib/diceTray/DiceBar.svelte
@@ -0,0 +1,337 @@
+<!--
+@component
+
+Floating dice bar at the composer. The viewer picks dice, a modifier and, in
+Daggerheart, advantage; the bar shows the roll command, for example
+`!r 2d12+1 adv`. Send posts it (`onsend`), then the bar shows the dice bot's
+result with coloured dice until the viewer starts a new roll.
+See `$lib/diceTray/diceTray.svelte`.
+-->
+<script lang="ts">
+  import { m } from '$lib/i18n/messages';
+  import { Button } from '$lib/ui/form';
+  import Deadline from '$lib/lifecycle/Deadline.svelte';
+  import { useServerScope } from '$lib/state/server/scope.svelte';
+  import {
+    DICE_SIDES,
+    applyDiceAction,
+    diceTray,
+    emptyRoll,
+    formatRollCommand,
+    isEmptyRoll,
+    isTraitPool,
+    type DiceAction,
+    type DiceRoll,
+    type DiceSystem
+  } from './diceTray.svelte';
+  import DieIcon from './DieIcon.svelte';
+
+  let {
+    roomId,
+    system,
+    disabled,
+    onsend
+  }: {
+    roomId: string;
+    system: DiceSystem;
+    disabled: boolean;
+    /** Posts the roll command; false when it was not sent. */
+    onsend: (command: string) => Promise<boolean>;
+  } = $props();
+
+  const serverScope = useServerScope();
+  const tray = diceTray(serverScope.serverId);
+
+  const daggerheart = $derived(system === 'dh');
+  const swade = $derived(system === 'swade');
+  let roll = $state<DiceRoll>(emptyRoll());
+  // Savage Worlds: the Wild Die is on for players and off in GM mode until the viewer picks.
+  let wildChoice = $state<boolean | null>(null);
+  const wild = $derived(wildChoice ?? !tray.viewerIsGm);
+  const wildApplies = $derived(swade && !roll.damage && isTraitPool(roll.pool));
+  const commandRoll = $derived<DiceRoll>({ ...roll, wild: wildApplies ? wild : null });
+  const command = $derived(formatRollCommand(commandRoll));
+  let sending = $state(false);
+  // The viewer's sent roll command, typed or from this bar.
+  const sent = $derived(tray.sentRoll(roomId));
+  let timedOutAt = $state<number | null>(null);
+  const timedOut = $derived(sent !== null && timedOutAt === sent.atMs);
+  const latest = $derived(tray.rolls(roomId).latestOf(serverScope.store.accountId));
+  const result = $derived(sent && latest && latest.eventId !== sent.before ? latest : null);
+  // Daggerheart duality roll: Hope, Fear, or a critical success on a double.
+  const duality = $derived.by(() => {
+    const hope = result?.dice.find((die) => die.kind === 'hope');
+    const fear = result?.dice.find((die) => die.kind === 'fear');
+    if (!hope || !fear) return null;
+    return hope.value === fear.value ? 'crit' : hope.value > fear.value ? 'hope' : 'fear';
+  });
+
+  function apply(action: DiceAction): void {
+    roll = applyDiceAction(roll, action);
+  }
+
+  async function send(): Promise<void> {
+    if (sending || disabled) return;
+    sending = true;
+    try {
+      // The composer records the sent command in the tray.
+      await onsend(command);
+    } finally {
+      sending = false;
+    }
+  }
+
+  function newRoll(): void {
+    tray.clearSentRoll(roomId);
+    roll = emptyRoll();
+    wildChoice = null;
+  }
+
+  // Savage Worlds trait roll with the Wild Die: the lower of trait die and Wild Die does not count.
+  const unusedKinds = $derived.by(() => {
+    const dice = result?.dice ?? [];
+    if (!result?.swade || !dice.some((die) => die.kind === 'wild')) return new Set<string>();
+    const sum = (wildDie: boolean) =>
+      dice.filter((die) => (die.kind === 'wild') === wildDie).reduce((a, die) => a + die.value, 0);
+    const wildWins = sum(true) > sum(false);
+    return new Set(wildWins ? ['std', 'gm'] : ['wild']);
+  });
+
+  // Thumbs up for a success with a green arrow per raise, thumbs down for a failure.
+  const swadeOutcome = $derived.by(() => {
+    const outcome = result?.swade;
+    if (!outcome) return null;
+    if (outcome === 'cf')
+      return { up: false, crit: true, raises: 0, label: m('composer.dice_tray.outcome_crit_fail') };
+    if (outcome === 'fail')
+      return { up: false, crit: false, raises: 0, label: m('composer.dice_tray.outcome_fail') };
+    const raises = outcome === 'ok' ? 0 : Number(outcome.slice(1));
+    return {
+      up: true,
+      crit: false,
+      raises,
+      label:
+        raises === 0
+          ? m('composer.dice_tray.outcome_success')
+          : m('composer.dice_tray.outcome_raises_count', { count: raises })
+    };
+  });
+
+  // Colours of the 3D dice in `$lib/dice/diceRenderer.ts`.
+  const DIE_COLOURS: Record<string, { body: string; ink: string; edge?: string }> = {
+    hope: { body: '#f2c230', ink: '#2a1a00', edge: '#a87b00' },
+    fear: { body: '#4b2178', ink: '#f1e6ff', edge: '#8e44ad' },
+    adv: { body: '#27ae60', ink: '#ffffff' },
+    dis: { body: '#c0392b', ink: '#ffffff' },
+    gm: { body: '#6e1a1a', ink: '#ffd27a' },
+    wild: { body: '#d35400', ink: '#ffffff' },
+    std: { body: '#f3efe4', ink: '#1f1f1f' },
+    drop: { body: '#8d8d8d', ink: '#e6e6e6' }
+  };
+  const dieColours = (kind: string) => DIE_COLOURS[kind] ?? DIE_COLOURS.std;
+  const OUTCOMES = {
+    hope: {
+      label: m('composer.dice_tray.outcome_hope'),
+      short: m('composer.dice_tray.outcome_hope_short')
+    },
+    fear: {
+      label: m('composer.dice_tray.outcome_fear'),
+      short: m('composer.dice_tray.outcome_fear_short')
+    },
+    crit: {
+      label: m('composer.dice_tray.outcome_crit'),
+      short: m('composer.dice_tray.outcome_crit_short')
+    }
+  };
+  const signed = (value: number) => (value > 0 ? `+${value}` : `${value}`);
+
+  const buttonClass =
+    'flex h-10 cursor-pointer items-center justify-center gap-1.5 rounded-md border border-text/25 px-2 text-sm font-medium hover:bg-surface-emphasized disabled:cursor-default disabled:opacity-50';
+</script>
+
+<div
+  role="toolbar"
+  tabindex="-1"
+  aria-label={m('composer.dice_tray.title')}
+  aria-orientation="vertical"
+  class="flex w-60 flex-col gap-1.5 menu p-2"
+  data-testid="dice-bar"
+  onpointerdown={(event) => event.preventDefault()}
+>
+  {#if sent}
+    <div class="flex flex-col gap-2 p-1" aria-live="polite" data-testid="dice-bar-result">
+      <div class="text-muted tabular-nums">{sent.command.replace(/^!\S+\s*/, '')}</div>
+      {#if result && !result.note}
+        {#if result.total !== null}
+          <div class="flex items-baseline gap-2 text-3xl font-semibold tabular-nums">
+            {result.total}
+            {#if swadeOutcome}
+              <span
+                class={['inline-flex items-center', swadeOutcome.crit && 'text-danger']}
+                title={swadeOutcome.label}
+                >(<span aria-hidden="true">{swadeOutcome.up ? '👍' : '👎'}</span
+                >{#if swadeOutcome.crit}!{/if}{#if swadeOutcome.raises > 3}<span
+                    aria-hidden="true"
+                    class="iconify icon-[uil--arrow-up] text-success"
+
+                  ></span>×{swadeOutcome.raises}{:else}{#each { length: swadeOutcome.raises } as _, index (index)}<span
+                      aria-hidden="true"
+                      class="iconify -mx-1 icon-[uil--arrow-up] text-success"
