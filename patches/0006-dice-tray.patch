+          onclick={() => apply({ advantage: 'adv' })}
+        >
+          {m('composer.dice_tray.advantage')}
+        </button>
+        <button
+          type="button"
+          class={[buttonClass, roll.advantage === 'dis' && 'bg-surface-selected']}
