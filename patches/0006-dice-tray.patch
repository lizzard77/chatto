index 000000000..2c3924f4b
--- /dev/null
+++ b/apps/frontend/src/lib/diceTray/diceTray.svelte.ts
@@ -0,0 +1,441 @@
+/**
+ * Dice tray: a dice bar at the composer and the latest dice bot results.
+ *
+ * Nothing here rolls. A click in the dice bar writes a `!r <notation>` command
+ * for a dice bot, for example Pantheon, into the composer; the viewer edits it
+ * and sends it with Enter. The tray reads the bot's replies. A reply carries a marker
+ * link `[🎲](#chatto-dice:<dice>;by=<userId>;gm=1)`; `by` names who rolled and
+ * `gm=1` marks a roll in the bot's GM mode. The bot posts the replies into a
+ * per-session collection thread of the room, which `!dice` in a thread sets up.
+ *
+ * Players see the latest roll of the room. A viewer whose own latest roll was a
+ * GM roll sees the latest roll per player instead. A bot reply to a roll command
+ * without dice, such as an error, carries an invisible note marker
+ * `[\u200b](#chatto-dice-note:by=<userId>)`; only the roller sees it in the tray.
+ * Both markers may carry `;sys=<system>`, the bot's dice system of the room, and a
+ * reply to the bot's system command carries `[\u200b](#chatto-dice-system:<system>)`.
+ * The bar offers advantage and disadvantage only while the room's system is `dh`.
+ * All state is device-local.
+ */
+
+import { Codecs, serverSlot, type StorageSlot } from '@chatto/client/storage/slot';
+
+/** Die sizes that the tray offers. */
+export const DICE_SIDES = [4, 6, 8, 10, 12, 20, 100] as const;
+export type DieSides = (typeof DICE_SIDES)[number];
+
+/** How many dice of each size the viewer picked. */
+export type DicePool = Partial<Record<DieSides, number>>;
+
+/** At most this many dice of one size, like the bot's own limit. */
+export const MAX_DICE_PER_SIZE = 10;
+
+const signed = (value: number) => (value > 0 ? `+${value}` : value < 0 ? `${value}` : '');
+
+/** Daggerheart advantage on the duality roll: the bot adds or subtracts a d6. */
+export type DiceAdvantage = 'dis' | 'normal' | 'adv';
+
+/**
+ * A roll command as tray contents. `wild` is null when the command names none;
+ * `advantage` is `normal` without `adv` or `dis`.
+ */
+export type DiceRoll = {
+  pool: DicePool;
+  modifier: number;
+  wild: boolean | null;
+  advantage: DiceAdvantage;
+  /** Savage Worlds damage roll (`!r dmg …`): all dice ace, no Wild Die. */
+  damage: boolean;
+};
+
+/** Whether the pool is exactly one die: a Savage Worlds trait roll. */
+export function isTraitPool(pool: DicePool): boolean {
+  const counts = Object.values(pool).filter((count) => (count ?? 0) > 0);
+  return counts.length === 1 && counts[0] === 1;
+}
+
+const ROLL_COMMAND = /^!(?:r|roll)(?:\s+(.*))?$/i;
+
+/**
+ * Reads a roll command such as `!r 2d6+d20+1`, `!r wild d8+1`, `!r dmg 2d6+1`
+ * or `!r +2 adv`. Returns null for other text and for rolls that the dice bar
+ * cannot show, such as macros or `4d6kh3`.
+ */
+export function parseRollCommand(text: string): DiceRoll | null {
+  const match = ROLL_COMMAND.exec(text.trim());
+  if (!match) return null;
+  let advantage: DiceAdvantage = 'normal';
+  // `adv` / `dis` may stand anywhere, as the bot reads them
+  let rest = (match[1] ?? '')
+    .split(/\s+/)
+    .filter((word) => {
+      const lower = word.toLowerCase();
+      if (lower === 'adv' || lower === 'advantage') advantage = 'adv';
+      else if (lower === 'dis' || lower === 'disadvantage') advantage = 'dis';
+      else return true;
+      return false;
+    })
+    .join(' ')
+    .trim();
+  let wild: boolean | null = null;
+  let damage = false;
+  const prefix = /^(wild|extra|dmg)\s+/i.exec(rest);
+  if (prefix) {
+    const word = prefix[1].toLowerCase();
+    if (word === 'dmg') damage = true;
+    else wild = word === 'wild';
+    rest = rest.slice(prefix[0].length);
+  }
+  const pool: DicePool = {};
+  let modifier = 0;
+  const input = rest.replace(/\s+/g, '');
+  if (!input) return { pool, modifier, wild, advantage, damage };
+  const term = /([+-])?(?:(\d*)[dDwW](\d+)|(\d+))/y;
+  let index = 0;
+  while (index < input.length) {
+    term.lastIndex = index;
+    const found = term.exec(input);
+    if (!found || (index > 0 && !found[1])) return null;
+    const sign = found[1] === '-' ? -1 : 1;
+    if (found[3]) {
+      const sides = Number(found[3]) as DieSides;
+      const count = found[2] ? Number(found[2]) : 1;
+      if (sign < 0 || !DICE_SIDES.includes(sides) || count < 1) return null;
+      const total = (pool[sides] ?? 0) + count;
+      if (total > MAX_DICE_PER_SIZE) return null;
+      pool[sides] = total;
+    } else {
+      modifier += sign * Number(found[4]);
+    }
+    index = term.lastIndex;
+  }
+  return { pool, modifier, wild, advantage, damage };
+}
+
+/** The bot command for tray contents, for example `!r wild d8+1` or `!r 2d12+2 adv`. */
+export function formatRollCommand({ pool, modifier, wild, advantage, damage }: DiceRoll): string {
+  const dice = DICE_SIDES.flatMap((sides) => {
+    const count = pool[sides] ?? 0;
+    return count > 0 ? [`${count > 1 ? count : ''}d${sides}`] : [];
+  }).join('+');
+  const formula = `${dice}${signed(modifier)}`;
+  const parts = [
+    damage ? 'dmg' : wild === null ? '' : wild ? 'wild' : 'extra',
+    formula,
+    advantage === 'normal' ? '' : advantage
+  ].filter(Boolean);
+  return parts.length ? `!r ${parts.join(' ')}` : '!r';
+}
+
+/** A click in the dice bar. */
+export type DiceAction = { die: DieSides } | { modifier: number } | { advantage: 'adv' | 'dis' };
+
+/** An empty roll: the dice bar starts with it. */
+export function emptyRoll(): DiceRoll {
+  return { pool: {}, modifier: 0, wild: null, advantage: 'normal', damage: false };
+}
+
+/** The roll after a dice bar click. Advantage toggles; a second click on it removes it. */
+export function applyDiceAction(roll: DiceRoll, action: DiceAction): DiceRoll {
+  if ('die' in action) {
+    const count = Math.min((roll.pool[action.die] ?? 0) + 1, MAX_DICE_PER_SIZE);
+    return { ...roll, pool: { ...roll.pool, [action.die]: count } };
+  }
+  if ('modifier' in action) return { ...roll, modifier: roll.modifier + action.modifier };
+  return { ...roll, advantage: roll.advantage === action.advantage ? 'normal' : action.advantage };
+}
+
+/** Whether a roll has nothing picked yet. */
+export function isEmptyRoll(roll: DiceRoll): boolean {
+  return (
+    DICE_SIDES.every((sides) => !roll.pool[sides]) &&
+    roll.modifier === 0 &&
+    roll.advantage === 'normal'
+  );
+}
+
+/** Dice systems of the bot; `dh` (Daggerheart) is the bot's default. */
+export type DiceSystem = 'dh' | 'swade' | 'raw';
+const DICE_SYSTEMS: readonly string[] = ['dh', 'swade', 'raw'];
+
+const SYSTEM_MARKER = /#chatto-dice(?:-system:|(?:-note)?:[^)\s]*;sys=)(\w{1,16})/;
+
+/** The dice system that a bot message names, or null. */
+export function parseDiceSystem(body: string): DiceSystem | null {
+  const system = SYSTEM_MARKER.exec(body)?.[1];
+  return system && DICE_SYSTEMS.includes(system) ? (system as DiceSystem) : null;
+}
+
+/**
+ * One die of a result, from the marker: `kind` is for example `hope`, `fear`,
+ * `adv`, `dis`, `wild`, `gm`, `std`, or `drop` (a die that does not count).
+ */
+export type TrayDie = { kind: string; sides: number; value: number };
+
+/** One dice bot result. */
+export type TrayRoll = {
+  eventId: string;
+  rollerId: string;
+  gm: boolean;
+  /** Readable result without markup, for example `Phil 🎲 12 — 3d6+4: [2, 5, 1]+4 = 12`. */
+  text: string;
+  createdAtMs: number;
+  /** A reply without dice (an error or a hint) that only the roller sees. */
+  note: boolean;
+  /** The dice of the result; empty for a note. */
+  dice: TrayDie[];
+  /** The total in bold at the start of the result, if any. */
+  total: number | null;
+  /** The result text without the roller's name, for example `🗡️ 16 (5+11) mit Furcht`. */
+  summary: string;
+  /**
+   * Savage Worlds trait roll outcome from the marker's `sw` parameter: `ok`,
+   * `r1` to `r9` (raises), `fail`, or `cf` (critical failure); null otherwise.
+   */
+  swade: string | null;
+};
+
+const DIE = /^(\w{1,16})\.(\d{1,3})\.(\d{1,4})$/;
+
+function parseDice(list: string): TrayDie[] {
+  return list.split(',').flatMap((entry) => {
+    const found = DIE.exec(entry);
+    return found ? [{ kind: found[1], sides: Number(found[2]), value: Number(found[3]) }] : [];
+  });
+}
+
+// The bot puts the roller's name in bold before the result.
+const ROLLER_NAME = /^\*\*(?:\\.|[^*\\])+\*\*\s+(?=\S)/;
+
+const MARKER = /\s*\[🎲\]\(#chatto-dice:([^)\s]{1,700})\)/g;
+const NOTE_MARKER = /\s*\[[^\]]{0,4}\]\(#chatto-dice-note:([^)\s]{1,200})\)/g;
+
+/** Strip Markdown emphasis and escapes so the result fits in one line of plain text. */
+function plainText(markdown: string): string {
+  return markdown
+    .replace(MARKER, '')
+    .replace(NOTE_MARKER, '')
+    .replace(/\u200b/g, '')
+    .replace(/(\*\*|__|~~|`)/g, '')
+    .replace(/\\([\\`*_~[\]()#>|@])/g, '$1')
+    .replace(/\s+/g, ' ')
+    .trim();
+}
+
+/** A dice bot result from a message body, or null when the body has no marker with `by`. */
+export function parseTrayRoll(eventId: string, body: string, createdAtMs: number): TrayRoll | null {
+  const dicePayload = [...body.matchAll(MARKER)][0]?.[1];
+  const notePayload = dicePayload ? undefined : [...body.matchAll(NOTE_MARKER)][0]?.[1];
+  if (!dicePayload && !notePayload) return null;
+  // The dice payload starts with the dice list; a note payload has parameters only.
+  const params: Record<string, string> = Object.fromEntries(
+    (dicePayload ? dicePayload.split(';').slice(1) : notePayload!.split(';')).map((param) =>
+      param.split('=')
+    )
+  );
+  const rollerId = params.by;
+  if (!rollerId) return null;
+  const result = body.replace(ROLLER_NAME, '');
+  const total = /\*\*(-?\d+)\*\*/.exec(result.replace(MARKER, ''))?.[1];
+  return {
+    eventId,
+    rollerId,
+    gm: params.gm === '1',
+    text: plainText(body),
+    createdAtMs,
+    note: !dicePayload,
+    dice: dicePayload ? parseDice(dicePayload.split(';')[0]) : [],
+    total: total === undefined ? null : Number(total),
+    summary: plainText(result),
+    swade: params.sw && /^(?:ok|fail|cf|r[1-9])$/.test(params.sw) ? params.sw : null
+  };
+}
+
+const MAX_ROLLS = 200;
+
+/** Results of one room, oldest first. */
+class RoomDiceRolls {
+  rolls = $state<TrayRoll[]>([]);
+
+  add(roll: TrayRoll): void {
+    if (this.rolls.some((existing) => existing.eventId === roll.eventId)) return;
+    const next = [...this.rolls, roll].sort((a, b) => a.createdAtMs - b.createdAtMs);
+    this.rolls = next.slice(-MAX_ROLLS);
+  }
+
+  get latest(): TrayRoll | null {
+    return this.rolls.findLast((roll) => !roll.note) ?? null;
+  }
+
+  /** The latest result or note of a roller, if any. */
+  latestOf(rollerId: string | null): TrayRoll | null {
+    if (!rollerId) return null;
+    return this.rolls.findLast((roll) => roll.rollerId === rollerId) ?? null;
+  }
+
+  /** The latest note (error or hint) for a roller, if any. */
+  latestNote(rollerId: string | null): TrayRoll | null {
+    if (!rollerId) return null;
+    return this.rolls.findLast((roll) => roll.note && roll.rollerId === rollerId) ?? null;
+  }
+
+  /** The latest roll of each roller, newest first. */
+  get latestPerRoller(): TrayRoll[] {
+    const byRoller: Record<string, TrayRoll> = {};
+    for (const roll of this.rolls) if (!roll.note) byRoller[roll.rollerId] = roll;
+    return Object.values(byRoller).sort((a, b) => b.createdAtMs - a.createdAtMs);
+  }
+}
+
+type RoomSystem = { system: DiceSystem; atMs: number };
+
+/**
+ * A roll command that the viewer sent from a composer, typed or from the dice
+ * bar. `roll` is null for commands that the bar cannot show, such as macros;
+ * `before` is the viewer's latest result before it, so the next one is the answer.
+ */
+export type SentRoll = {
+  command: string;
+  roll: DiceRoll | null;
+  before: string | null;
+  atMs: number;
+};
+
+const systemsCodec = Codecs.json<Record<string, RoomSystem>>(
+  (value): value is Record<string, RoomSystem> =>
+    typeof value === 'object' &&
+    value !== null &&
+    Object.values(value).every(
+      (entry) =>
+        typeof entry === 'object' &&
+        entry !== null &&
+        DICE_SYSTEMS.includes((entry as RoomSystem).system) &&
+        typeof (entry as RoomSystem).atMs === 'number'
+    )
+);
+
+const barCodec = Codecs.json<Record<string, boolean>>(
+  (value): value is Record<string, boolean> =>
+    typeof value === 'object' &&
+    value !== null &&
+    Object.values(value).every((shown) => typeof shown === 'boolean')
+);
+
+const threadsCodec = Codecs.json<Record<string, string>>(
+  (value): value is Record<string, string> =>
+    typeof value === 'object' &&
+    value !== null &&
+    Object.values(value).every((thread) => typeof thread === 'string')
+);
+
+/** Dice tray state of one server. */
+export class ServerDiceTray {
+  readonly #threads: StorageSlot<Record<string, string>>;
+  readonly #gm: StorageSlot<boolean>;
+  readonly #systems: StorageSlot<Record<string, RoomSystem>>;
+  readonly #bar: StorageSlot<Record<string, boolean>>;
+  // Each RoomDiceRolls is reactive itself; this only hands out one per room.
+  readonly #rooms: Record<string, RoomDiceRolls> = {};
+  #threadIds = $state<Record<string, string>>({});
+  #systemByRoom = $state<Record<string, RoomSystem>>({});
+  #barByRoom = $state<Record<string, boolean>>({});
+  #sentByRoom = $state<Record<string, SentRoll>>({});
+  /** The viewer's own latest roll was a GM roll. */
+  viewerIsGm = $state(false);
+
+  constructor(serverId: string) {
+    this.#threads = serverSlot(serverId, 'dice-tray-threads', {}, threadsCodec);
+    this.#gm = serverSlot(serverId, 'dice-tray-gm', false, Codecs.boolean);
+    this.#threadIds = this.#threads.get();
+    this.viewerIsGm = this.#gm.get();
+    this.#systems = serverSlot(serverId, 'dice-tray-systems', {}, systemsCodec);
+    this.#systemByRoom = this.#systems.get();
+    this.#bar = serverSlot(serverId, 'dice-bar-rooms', {}, barCodec);
+    this.#barByRoom = this.#bar.get();
+  }
+
+  /** Whether the dice bar shows in a room; it shows until the viewer hides it there. */
+  barVisible(roomId: string): boolean {
+    return this.#barByRoom[roomId] ?? true;
+  }
+
+  /** The viewer's last sent roll command in a room, until the viewer starts a new roll. */
+  sentRoll(roomId: string): SentRoll | null {
+    return this.#sentByRoom[roomId] ?? null;
+  }
+
+  /** Record a message that the viewer sends; only roll commands (`!r`, `!roll`) count. */
+  noteRollSent(roomId: string, body: string, viewerId: string | null): void {
+    const command = body.trim();
+    if (!ROLL_COMMAND.test(command)) return;
+    const before = this.rolls(roomId).latestOf(viewerId)?.eventId ?? null;
+    const roll = parseRollCommand(command);
+    this.#sentByRoom = {
+      ...this.#sentByRoom,
+      [roomId]: { command, roll, before, atMs: Date.now() }
+    };
+  }
+
+  clearSentRoll(roomId: string): void {
+    const { [roomId]: _, ...rest } = this.#sentByRoom;
+    this.#sentByRoom = rest;
+  }
+
+  setBarVisible(roomId: string, visible: boolean): void {
+    this.#barByRoom = { ...this.#barByRoom, [roomId]: visible };
+    this.#bar.set(this.#barByRoom);
+  }
+
+  /** The room's dice system as the bot last reported it; the bot's default before that. */
+  system(roomId: string): DiceSystem {
+    return this.#systemByRoom[roomId]?.system ?? 'dh';
+  }
+
+  /** Record the system that a bot message names; older messages never win. */
+  noteSystem(roomId: string, system: DiceSystem, atMs: number): void {
+    const known = this.#systemByRoom[roomId];
+    if (known && known.atMs >= atMs) return;
+    this.#systemByRoom = { ...this.#systemByRoom, [roomId]: { system, atMs } };
+    this.#systems.set(this.#systemByRoom);
+  }
+
+  /** The collection thread that the bot last posted a roll into, if known. */
+  diceThread(roomId: string): string | null {
+    return this.#threadIds[roomId] ?? null;
+  }
+
+  rolls(roomId: string): RoomDiceRolls {
+    return (this.#rooms[roomId] ??= new RoomDiceRolls());
+  }
+
+  /** Record a result; `threadRootEventId` is the thread the bot posted it into. */
+  ingest(
+    roomId: string,
+    roll: TrayRoll,
+    threadRootEventId: string | null,
+    viewerId: string | null,
+    { live }: { live: boolean }
+  ): void {
+    this.rolls(roomId).add(roll);
+    if (live && threadRootEventId && this.#threadIds[roomId] !== threadRootEventId) {
+      this.#threadIds = { ...this.#threadIds, [roomId]: threadRootEventId };
+      this.#threads.set(this.#threadIds);
+    }
+    const own = viewerId !== null && roll.rollerId === viewerId;
+    // Only the viewer's newest own roll decides, also when older rolls load later.
+    const ownLatest = own
+      ? this.rolls(roomId).latestPerRoller.find((r) => r.rollerId === viewerId)
+      : undefined;
+    if (ownLatest?.eventId === roll.eventId) {
+      this.viewerIsGm = roll.gm;
+      this.#gm.set(roll.gm);
+    }
+  }
+}
+
+const trays: Record<string, ServerDiceTray> = {};
+
+/** The dice tray state of a server, shared by its composers and panes. */
+export function diceTray(serverId: string): ServerDiceTray {
+  return (trays[serverId] ??= new ServerDiceTray(serverId));
+}
